@{
    ViewData["Title"] = "Quản lý Discount";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Quản lý Discount</h1>
        <div>
            <button type="button" class="btn btn-primary" onclick="openAddDiscountModal()">
                <i class="fas fa-plus me-2"></i>Thêm Discount
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Bộ lọc</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <label for="searchInput" class="form-label">Tìm kiếm</label>
                    <input type="text" class="form-control" id="searchInput" placeholder="Tìm theo mã, tiêu đề...">
                </div>
                <div class="col-md-4">
                    <label for="statusFilter" class="form-label">Trạng thái</label>
                    <select class="form-select" id="statusFilter">
                        <option value="">Tất cả trạng thái</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-primary me-2" onclick="applyFilters()">
                        <i class="fas fa-search me-1"></i>Lọc
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="clearFilters()">
                        <i class="fas fa-redo me-1"></i>Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Discounts Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách Discount</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="discountsTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Mã Discount</th>
                            <th>Tiêu đề</th>
                            <th>Phần trăm giảm</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data will be loaded via AJAX -->
                    </tbody>
                </table>
            </div>
            <!-- Pagination -->
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center" id="pagination">
                    <!-- Pagination will be generated by JavaScript -->
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Add/Edit Discount Modal -->
<div class="modal fade" id="discountModal" tabindex="-1" aria-labelledby="discountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="discountModalLabel">Thêm Discount</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="discountForm">
                    <input type="hidden" id="discountId" name="discountId">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="discountCode" class="form-label">Mã Discount <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="discountCode" name="discountCode" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="discountPercent" class="form-label">Phần trăm giảm (%) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="discountPercent" name="discountPercent" min="0" max="100" step="0.01" required>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="discountTitle" class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="discountTitle" name="discountTitle" required>
                    </div>
                    <div class="mb-3">
                        <label for="discountInfor" class="form-label">Thông tin</label>
                        <textarea class="form-control" id="discountInfor" name="discountInfor" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="status" class="form-label">Trạng thái <span class="text-danger">*</span></label>
                                <select class="form-select" id="status" name="status" required>
                                    <option value="1">Active</option>
                                    <option value="0">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveDiscount()">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" style="display: none;"></span>
                    Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa discount này không?</p>
                <div id="deleteDiscountInfo"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" style="display: none;"></span>
                    Xóa
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(() => {
        if (typeof $ !== 'undefined') {
            initializeApp();
        } else {
            initializeWithoutJQuery();
        }
    }, 1000);
});

function initializeWithoutJQuery() {
    window.currentPage = 1;
    window.pageSize = 10;
    window.deleteDiscountId = null;
    
    loadDiscountsVanilla();
}

function initializeApp() {
    window.currentPage = 1;
    window.pageSize = 10;
    window.deleteDiscountId = null;

    loadStatuses();
    loadDiscounts();
}

function loadStatuses() {
    if (typeof $ === 'undefined') {
        return;
    }
    
    $.get('/DiscountManage/GetDiscountStatuses')
        .done(function(response) {
            if (response && response.success) {
                const statusFilter = document.getElementById('statusFilter');
                if (statusFilter) {
                    response.data.forEach(status => {
                        const option = document.createElement('option');
                        option.value = status.statusId;
                        option.textContent = status.statusName;
                        statusFilter.appendChild(option);
                    });
                }
            }
        })
        .fail(function(xhr, status, error) {
            console.error('Failed to load statuses:', error);
        });
}

function loadCustomers() {
    // Function removed - customers no longer needed
}

function loadDiscounts() {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    
    const requestData = {
        page: window.currentPage,
        pageSize: window.pageSize,
        searchTerm: searchInput ? searchInput.value || null : null,
        status: statusFilter && statusFilter.value ? parseInt(statusFilter.value) : null,
        customerId: null
    };

    fetch('http://localhost:5077/api/Manager/discounts/list', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(requestData)
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
    })
    .then(response => {
        if (response && response.success && response.data) {
            populateDiscountsTable(response.data);
            if (response.pagination) {
                updatePagination(response.pagination);
            }
        } else {
            showError('Lỗi khi tải danh sách discount: ' + (response ? response.message : 'Invalid response'));
        }
    })
    .catch(error => {
        showError('Lỗi kết nối server: ' + error.message);
    });
}

function loadDiscountsVanilla() {
    const requestData = {
        page: 1,
        pageSize: 10,
        searchTerm: null,
        status: null,
        customerId: null
    };

    fetch('http://localhost:5077/api/Manager/discounts/list', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(requestData)
    })
    .then(response => response.json())
    .then(response => {
        if (response && response.success && response.data) {
            populateDiscountsTableVanilla(response.data);
        }
    })
    .catch(error => {
        console.error('Vanilla fetch error:', error);
    });
}

function populateDiscountsTable(discounts) {
    const tbody = document.querySelector('#discountsTable tbody');
    if (!tbody) {
        return;
    }
    
    tbody.innerHTML = '';
    
    if (!discounts || discounts.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center">Không có dữ liệu</td></tr>';
        return;
    }
    
    discounts.forEach((discount, index) => {
        const statusBadge = discount.status === 1 ? 
            '<span class="badge bg-success">Active</span>' : 
            '<span class="badge bg-secondary">Inactive</span>';
            
        const row = `
            <tr>
                <td>${discount.discountId}</td>
                <td><strong>${discount.discountCode}</strong></td>
                <td>${discount.discountTitle}</td>
                <td>${discount.discountPercent}%</td>
                <td>${statusBadge}</td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="editDiscount(${discount.discountId})" title="Chỉnh sửa">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="showDeleteModal(${discount.discountId}, '${discount.discountCode}')" title="Xóa">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;
        tbody.innerHTML += row;
    });
}

function populateDiscountsTableVanilla(discounts) {
    const tbody = document.querySelector('#discountsTable tbody');
    if (!tbody) {
        return;
    }
    
    tbody.innerHTML = '';
    
    if (!discounts || discounts.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center">Không có dữ liệu</td></tr>';
        return;
    }
    
    discounts.forEach(discount => {
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>${discount.discountId}</td>
            <td><strong>${discount.discountCode}</strong></td>
            <td>${discount.discountTitle}</td>
            <td>${discount.discountPercent}%</td>
            <td><span class="badge ${discount.status === 1 ? 'bg-success' : 'bg-secondary'}">${discount.status === 1 ? 'Active' : 'Inactive'}</span></td>
            <td>
                <button type="button" class="btn btn-sm btn-outline-primary me-1">
                    <i class="fas fa-edit"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger">
                    <i class="fas fa-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(row);
    });
}

function updatePagination(pagination) {
    const paginationEl = document.getElementById('pagination');
    if (!paginationEl) return;
    
    paginationEl.innerHTML = '';
    
    if (pagination.totalPages <= 1) return;
    
    // Previous button
    if (pagination.currentPage > 1) {
        paginationEl.innerHTML += `<li class="page-item"><a class="page-link" href="#" onclick="changePage(${pagination.currentPage - 1})">‹</a></li>`;
    }
    
    // Page numbers
    for (let i = 1; i <= pagination.totalPages; i++) {
        const activeClass = i === pagination.currentPage ? 'active' : '';
        paginationEl.innerHTML += `<li class="page-item ${activeClass}"><a class="page-link" href="#" onclick="changePage(${i})">${i}</a></li>`;
    }
    
    // Next button
    if (pagination.currentPage < pagination.totalPages) {
        paginationEl.innerHTML += `<li class="page-item"><a class="page-link" href="#" onclick="changePage(${pagination.currentPage + 1})">›</a></li>`;
    }
}

// Make functions globally available
window.loadDiscounts = loadDiscounts;
window.populateDiscountsTable = populateDiscountsTable;
window.updatePagination = updatePagination;

function changePage(page) {
    window.currentPage = page;
    window.loadDiscounts();
}

function applyFilters() {
    window.currentPage = 1;
    window.loadDiscounts();
}

function clearFilters() {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    
    if (searchInput) searchInput.value = '';
    if (statusFilter) statusFilter.value = '';
    
    window.currentPage = 1;
    window.loadDiscounts();
}

function openAddDiscountModal() {
    if (typeof $ !== 'undefined') {
        $('#discountModalLabel').text('Thêm Discount');
        $('#discountForm')[0].reset();
        $('#discountId').val('');
        $('#discountModal').modal('show');
    }
}

function editDiscount(id) {
    if (typeof $ !== 'undefined') {
        $.get(`/DiscountManage/GetDiscount?id=${id}`, function(response) {
            if (response.success) {
                const discount = response.data;
                $('#discountModalLabel').text('Chỉnh sửa Discount');
                $('#discountId').val(discount.discountId);
                $('#discountCode').val(discount.discountCode);
                $('#discountPercent').val(discount.discountPercent);
                $('#discountTitle').val(discount.discountTitle);
                $('#discountInfor').val(discount.discountInfor);
                $('#status').val(discount.status);
                $('#discountModal').modal('show');
            } else {
                showError('Lỗi khi tải thông tin discount: ' + response.message);
            }
        });
    }
}

function saveDiscount() {
    if (typeof $ === 'undefined') return;
    
    const form = $('#discountForm')[0];
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    const button = $('.modal-footer .btn-primary');
    const spinner = button.find('.spinner-border');
    button.prop('disabled', true);
    spinner.show();

    const discountId = $('#discountId').val();
    const isEdit = discountId !== '';
    
    const discountData = {
        discountCode: $('#discountCode').val(),
        discountPercent: parseFloat($('#discountPercent').val()),
        discountTitle: $('#discountTitle').val(),
        discountInfor: $('#discountInfor').val() || null,
        customerId: 1, // Default customer ID
        status: parseInt($('#status').val())
    };

    if (isEdit) {
        discountData.discountId = parseInt(discountId);
    }

    const url = isEdit ? `/DiscountManage/UpdateDiscount?id=${discountId}` : '/DiscountManage/CreateDiscount';
    const method = isEdit ? 'PUT' : 'POST';

    $.ajax({
        url: url,
        type: method,
        contentType: 'application/json',
        data: JSON.stringify(discountData),
        success: function(response) {
            if (response.success) {
                $('#discountModal').modal('hide');
                window.loadDiscounts();
                showSuccess(isEdit ? 'Cập nhật discount thành công!' : 'Thêm discount thành công!');
            } else {
                showError('Lỗi: ' + response.message);
            }
        },
        error: function() {
            showError('Lỗi kết nối server');
        },
        complete: function() {
            button.prop('disabled', false);
            spinner.hide();
        }
    });
}

function showDeleteModal(id, code) {
    if (typeof $ !== 'undefined') {
        window.deleteDiscountId = id;
        $('#deleteDiscountInfo').html(`<strong>Mã Discount:</strong> ${code}`);
        $('#deleteModal').modal('show');
    }
}

function confirmDelete() {
    if (!window.deleteDiscountId || typeof $ === 'undefined') return;

    const button = $('#deleteModal .btn-danger');
    const spinner = button.find('.spinner-border');
    button.prop('disabled', true);
    spinner.show();

    $.ajax({
        url: `/DiscountManage/DeleteDiscount?id=${window.deleteDiscountId}`,
        type: 'DELETE',
        success: function(response) {
            if (response.success) {
                $('#deleteModal').modal('hide');
                window.loadDiscounts();
                showSuccess('Xóa discount thành công!');
            } else {
                showError('Lỗi: ' + response.message);
            }
        },
        error: function() {
            showError('Lỗi kết nối server');
        },
        complete: function() {
            button.prop('disabled', false);
            spinner.hide();
            window.deleteDiscountId = null;
        }
    });
}

function showSuccess(message) {
    alert(message);
}

function showError(message) {
    alert(message);
}
</script>
