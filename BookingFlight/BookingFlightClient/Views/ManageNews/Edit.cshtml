@model BookingFlightClient.Models.DTO.ResponseNewsDTO

@{
    ViewData["Title"] = "Chi tiết & Chỉnh sửa tin tức";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">
            <i class="bi bi-pencil-square"></i> Chỉnh sửa Tin tức
        </h2>
        <a href="@Url.Action("Index", "ManageNews")" class="btn btn-secondary shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="NewId" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Hình ảnh hiện tại</label><br />
                    <img src="~/images/@Model.Image" alt="@Model.Title" class="rounded shadow-sm" style="width: 200px; height: auto;" />
                </div>

                <div class="mb-3">
                    <label for="ImageUpload" class="form-label fw-semibold">Cập nhật hình ảnh</label>
                    <input type="file" name="ImageUpload" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label fw-semibold">Nội dung</label>
                    <textarea asp-for="Content" rows="6" class="form-control" placeholder="Nhập nội dung..."></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label fw-semibold">Danh mục</label>
                        <input asp-for="Category" class="form-control" placeholder="Danh mục" />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Author" class="form-label fw-semibold">Tác giả</label>
                        <input asp-for="Author" class="form-control" placeholder="Tác giả" />
                        <span asp-validation-for="Author" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AccountName" class="form-label fw-semibold">Tên tài khoản</label>
                        <input asp-for="AccountName" class="form-control" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="AccountId" class="form-label fw-semibold">ID Tài khoản</label>
                        <input asp-for="AccountId" class="form-control" readonly />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary me-2 shadow-sm">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                    <a href="@Url.Action("Index", "ManageNews")" class="btn btn-outline-secondary shadow-sm">
                        <i class="bi bi-x-circle"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
