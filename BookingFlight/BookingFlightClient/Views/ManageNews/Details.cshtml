@model BookingFlightClient.Models.DTO.ResponseNewsDTO

@{
    ViewData["Title"] = Model.Title;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .news-header {
        background: linear-gradient(to right, #4facfe, #00f2fe);
        color: #fff;
        padding: 50px 20px;
        text-align: center;
        border-radius: 12px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    .news-image {
        width: 100%;
        max-height: 500px;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 30px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .news-content {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #333;
    }

    .news-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #ddd;
        margin-top: 40px;
        padding: 20px;
        border-radius: 0 0 12px 12px;
    }

    .news-meta i {
        color: #0d6efd;
        margin-right: 6px;
    }
</style>

<div class="container my-5">
    <!-- Back Button -->
    <div class="mb-3">
        <a href="@Url.Action("Index", "ManageNews")" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <!-- News Header -->
    <div class="news-header">
        <h1 class="fw-bold">@Model.Title</h1>
    </div>

    <!-- News Image -->
    <div class="text-center mt-4">
        <img src="~/images/@Model.Image" alt="@Model.Title" class="news-image" />
    </div>

    <!-- News Content -->
    <div class="news-content mt-4">
        @Html.Raw(Model.Content.Replace("\n", "<br />"))
    </div>

    <!-- News Footer -->
    <div class="news-footer mt-5">
        <div class="row">
            <div class="col-md-6 news-meta mb-2">
                <i class="bi bi-tags"></i> <strong>Danh mục:</strong> @Model.Category
            </div>
            <div class="col-md-6 news-meta mb-2">
                <i class="bi bi-person"></i> <strong>Tác giả:</strong> @Model.Author
            </div>
            <div class="col-md-6 news-meta">
                <i class="bi bi-person-badge"></i> <strong>Tài khoản:</strong> @Model.AccountName (ID: @Model.AccountId)
            </div>
        </div>
    </div>
</div>
