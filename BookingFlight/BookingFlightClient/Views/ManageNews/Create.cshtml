@model BookingFlightClient.Models.DTO.RequestAddNewsDTO

@{
    ViewData["Title"] = "Tạo Bản Tin Mới";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">

<style>
    .create-header {
        background: linear-gradient(to right, #4facfe, #00f2fe);
        color: #fff;
        padding: 30px 20px;
        text-align: center;
        border-radius: 12px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        margin-bottom: 30px;
    }

    .form-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        padding: 30px;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px 15px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #4facfe;
        box-shadow: 0 0 0 3px rgba(79, 172, 254, 0.1);
        outline: none;
    }

    .btn-primary-custom {
        background: linear-gradient(45deg, #4facfe, #00f2fe);
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        color: white;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(79, 172, 254, 0.3);
        transition: all 0.3s ease;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(79, 172, 254, 0.4);
    }

    .btn-secondary-custom {
        background: #6c757d;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-secondary-custom:hover {
        background: #5a6268;
        transform: translateY(-2px);
    }

    .image-preview {
        margin-top: 15px;
        text-align: center;
    }

    .image-preview img {
        max-width: 300px;
        max-height: 200px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .file-upload-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
        width: 100%;
    }

    .file-upload-wrapper input[type=file] {
        position: absolute;
        left: -9999px;
    }

    .file-upload-label {
        padding: 12px 15px;
        border: 2px dashed #e2e8f0;
        border-radius: 8px;
        cursor: pointer;
        text-align: center;
        transition: all 0.3s ease;
        display: block;
        background: #f7fafc;
        color: #4a5568;
    }

    .file-upload-label:hover {
        border-color: #4facfe;
        background: #ebf8ff;
        color: #2b6cb0;
    }

    .required {
        color: #e53e3e;
    }
</style>

<div class="container my-5">
    <!-- Header -->
    <div class="create-header">
        <h2><i class="bi bi-plus-circle me-2"></i>Tạo Bản Tin Mới</h2>
        <p class="mb-0">Thêm bài viết tin tức mới vào hệ thống</p>
    </div>

    <!-- Form Container -->
    <div class="form-container">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-md-8">
                    <!-- Title -->
                    <div class="form-group">
                        <label asp-for="Title" class="form-label">
                            <i class="bi bi-card-heading me-2"></i>Tiêu đề <span class="required">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề bản tin..." />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <!-- Content -->
                    <div class="form-group">
                        <label asp-for="Content" class="form-label">
                            <i class="bi bi-file-text me-2"></i>Nội dung <span class="required">*</span>
                        </label>
                        <textarea asp-for="Content" class="form-control" rows="8" 
                                  placeholder="Nhập nội dung chi tiết của bản tin..." 
                                  id="content-editor"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Category -->
                    <div class="form-group">
                        <label asp-for="Category" class="form-label">
                            <i class="bi bi-tag me-2"></i>Danh mục <span class="required">*</span>
                        </label>
                        <select asp-for="Category" class="form-control">
                            <option value="">Chọn danh mục...</option>
                            <option value="Tin tức">Tin tức</option>
                            <option value="Khuyến mãi">Khuyến mãi</option>
                            <option value="Sự kiện">Sự kiện</option>
                            <option value="Thông báo">Thông báo</option>
                            <option value="Hướng dẫn">Hướng dẫn</option>
                            <option value="Cập nhật">Cập nhật</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <!-- Author -->
                    <div class="form-group">
                        <label asp-for="Author" class="form-label">
                            <i class="bi bi-person me-2"></i>Tác giả <span class="required">*</span>
                        </label>
                        <input asp-for="Author" class="form-control" placeholder="Nhập tên tác giả..." />
                        <span asp-validation-for="Author" class="text-danger"></span>
                    </div>

                    <!-- Image Upload -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-image me-2"></i>Hình ảnh đại diện
                        </label>
                        <div class="file-upload-wrapper">
                            <input type="file" id="imageUpload" name="imageUpload" accept="image/*">
                            <label for="imageUpload" class="file-upload-label">
                                <i class="bi bi-cloud-upload me-2"></i>
                                Chọn hình ảnh...
                            </label>
                        </div>
                        <div class="image-preview" id="imagePreview" style="display: none;">
                            <img id="previewImg" src="" alt="Preview" />
                            <div class="mt-2">
                                <small class="text-muted">Xem trước hình ảnh</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top: 1px solid #e2e8f0;">
                <a href="@Url.Action("Index", "ManageNews")" class="btn btn-secondary-custom">
                    <i class="bi bi-arrow-left me-2"></i>Quay Lại
                </a>
                
                <button type="submit" class="btn btn-primary-custom">
                    <i class="bi bi-check-circle me-2"></i>Tạo Bản Tin
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.js"></script>
    <script>
        $(document).ready(function() {
            // Initialize Summernote for rich text editing
            $('#content-editor').summernote({
                height: 300,
                placeholder: 'Nhập nội dung chi tiết của bản tin...',
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'underline', 'clear']],
                    ['fontname', ['fontname']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture']],
                    ['view', ['fullscreen', 'codeview']]
                ]
            });

            // Image preview functionality
            $('#imageUpload').on('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        $('#previewImg').attr('src', e.target.result);
                        $('#imagePreview').show();
                    };
                    reader.readAsDataURL(file);
                    
                    // Update label text
                    $('.file-upload-label').html('<i class="bi bi-check-circle me-2"></i>' + file.name);
                } else {
                    $('#imagePreview').hide();
                    $('.file-upload-label').html('<i class="bi bi-cloud-upload me-2"></i>Chọn hình ảnh...');
                }
            });

            // Form validation
            $('form').on('submit', function(e) {
                let isValid = true;
                const requiredFields = ['Title', 'Content', 'Category', 'Author'];
                
                requiredFields.forEach(field => {
                    const input = $(`[name="${field}"]`);
                    if (!input.val().trim()) {
                        isValid = false;
                        input.addClass('is-invalid');
                    } else {
                        input.removeClass('is-invalid');
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    alert('Vui lòng điền đầy đủ các trường bắt buộc!');
                }
            });
        });
    </script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}