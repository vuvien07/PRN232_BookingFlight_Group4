@model List<BookingFlightClient.Models.DTO.ResponseNewsDTO>

@{
    ViewData["Title"] = "Quản lý Tin tức";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">
            <i class="bi bi-newspaper"></i> Quản lý Tin tức
        </h2>
        <a href="@Url.Action("Create", "ManageNews")" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm tin mới
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle table-bordered">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Tiêu đề</th>
                        <th>Hình ảnh</th>
                        <th>Danh mục</th>
                        <th>Tác giả</th>
                        <th>Tài khoản</th>
                        <th style="width: 150px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var news = Model[i];
                        <tr>
                            <td class="text-center fw-bold">@((i + 1))</td>
                            <td>
                                <span class="fw-semibold">@news.Title</span>
                                <br />
                                <small class="text-muted">ID: @news.NewId</small>
                            </td>
                            <td class="text-center">
                                <img src="~/images/@news.Image" alt="@news.Title" class="rounded shadow-sm" style="width: 80px; height: 60px; object-fit: cover;" />
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary">@news.Category</span>
                            </td>
                            <td class="text-center">@news.Author</td>
                            <td class="text-center">
                                <span>@news.AccountName</span><br />
                                <small class="text-muted">(ID: @news.AccountId)</small>
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a href="@Url.Action("Details", "ManageNews", new { newId = news.NewId })" class="btn btn-sm btn-primary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", "ManageNews", new { newId = news.NewId })" class="btn btn-sm btn-warning" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", "ManageNews", new { newId = news.NewId })" class="btn btn-sm btn-danger" title="Xóa"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa tin này không?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info shadow-sm text-center">
            <i class="bi bi-info-circle"></i> Hiện chưa có tin tức nào.
        </div>
    }
</div>
