@model BookingFlightClient.Models.DTO.ResponseNewsDTO

@{
    ViewData["Title"] = "Xóa Bản Tin";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="~/css/manage-news-delete.css" rel="stylesheet" />

<div class="delete-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
                <div class="delete-main-card">
                    <!-- Header -->
                    <div class="delete-header">
                        <h2><i class="bi bi-exclamation-triangle me-3"></i>Xác Nhận Xóa Bản Tin</h2>
                        <p>Bạn có chắc chắn muốn xóa bản tin này không?</p>
                    </div>

                    <!-- Warning Section -->
                    <div class="warning-section">
                        <div class="warning-box">
                            <div class="warning-content">
                                <i class="bi bi-exclamation-triangle-fill warning-icon"></i>
                                <div class="warning-text">
                                    <h5><i class="bi bi-shield-exclamation me-2"></i>Cảnh báo quan trọng!</h5>
                                    <p>Hành động này không thể hoàn tác. Bản tin sẽ bị xóa vĩnh viễn khỏi hệ thống cùng với tất cả dữ liệu liên quan.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- News Preview Section -->
                    <div class="news-preview-section">
                        <div class="news-preview">
                            <h3 class="news-title">
                                <i class="bi bi-newspaper me-2"></i>
                                @Model.Title
                            </h3>

                            <div class="news-meta">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="meta-row">
                                            <i class="bi bi-tags-fill"></i>
                                            <span><strong>Danh mục:</strong> @Model.Category</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="meta-row">
                                            <i class="bi bi-person-fill"></i>
                                            <span><strong>Tác giả:</strong> @Model.Author</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="meta-row">
                                            <i class="bi bi-person-badge-fill"></i>
                                            <span><strong>Tài khoản:</strong> @Model.AccountName</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <div class="text-center">
                                    <img src="~/images/@Model.Image" alt="@Model.Title" class="news-image" />
                                </div>
                            }

                            <div class="news-content-preview">
                                <h6>
                                    <i class="bi bi-file-text-fill"></i>
                                    Nội dung bản tin:
                                </h6>
                                <div class="content-text">
                                    @{
                                        var contentPreview = Model.Content.Length > 300 
                                            ? Model.Content.Substring(0, 300) + "..." 
                                            : Model.Content;
                                    }
                                    @Html.Raw(contentPreview)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Section -->
                    <div class="action-section">
                        <div class="action-buttons">
                            <a href="@Url.Action("Index", "ManageNews")" class="btn-cancel">
                                <i class="bi bi-arrow-left me-2"></i>Hủy bỏ
                            </a>

                            <form asp-action="Delete" method="post" style="display: inline;" id="deleteForm">
                                <input type="hidden" asp-for="NewId" />
                                <button type="submit" class="btn-confirm-delete" id="confirmDeleteBtn">
                                    <span class="spinner-wrapper">
                                        <div class="loading-spinner" id="deleteSpinner"></div>
                                        <i class="bi bi-trash3-fill me-2" id="deleteIcon"></i>
                                        <span id="deleteText">Xác nhận xóa</span>
                                    </span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Form submission handler with confirmation
        document.getElementById('deleteForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            const deleteSpinner = document.getElementById('deleteSpinner');
            const deleteIcon = document.getElementById('deleteIcon');
            const deleteText = document.getElementById('deleteText');
            
            // Show confirmation dialog
            if (confirm('Bạn có THỰC SỰ chắc chắn muốn xóa bản tin này không?\n\nHành động này không thể hoàn tác!')) {
                // Show loading state
                deleteSpinner.style.display = 'block';
                deleteIcon.style.display = 'none';
                deleteText.textContent = 'Đang xóa...';
                confirmDeleteBtn.disabled = true;
                
                // Add visual feedback
                confirmDeleteBtn.style.background = 'linear-gradient(45deg, #6c757d, #5a6268)';
                
                // Submit form after short delay for better UX
                setTimeout(() => {
                    this.submit();
                }, 500);
            }
        });

        // Add hover effects for better interaction
        document.getElementById('confirmDeleteBtn').addEventListener('mouseenter', function() {
            if (!this.disabled) {
                this.style.animation = 'shake 0.5s ease-in-out';
                this.addEventListener('animationend', function() {
                    this.style.animation = '';
                });
            }
        });

        // Auto-scroll to warning box after page load
        document.addEventListener('DOMContentLoaded', function() {
            const warningBox = document.querySelector('.warning-box');
            if (warningBox) {
                setTimeout(() => {
                    warningBox.scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'center' 
                    });
                }, 500);
            }
        });

        // Add keyboard shortcut for quick cancel (Escape key)
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                window.location.href = '@Url.Action("Index", "ManageNews")';
            }
        });

        // Progressive enhancement for image loading
        document.addEventListener('DOMContentLoaded', function() {
            const newsImage = document.querySelector('.news-image');
            if (newsImage) {
                newsImage.addEventListener('load', function() {
                    this.style.opacity = '0';
                    this.style.transition = 'opacity 0.5s ease-in-out';
                    setTimeout(() => {
                        this.style.opacity = '1';
                    }, 100);
                });
            }
        });

        // Add copy news title to clipboard functionality
        document.querySelector('.news-title').addEventListener('click', function() {
            const title = this.textContent.trim();
            navigator.clipboard.writeText(title).then(function() {
                // Show temporary feedback
                const originalHTML = document.querySelector('.news-title').innerHTML;
                document.querySelector('.news-title').innerHTML = 
                    '<i class="bi bi-check-circle-fill me-2" style="color: #48bb78;"></i>Đã sao chép tiêu đề!';
                
                setTimeout(() => {
                    document.querySelector('.news-title').innerHTML = originalHTML;
                }, 2000);
            }).catch(function() {
                console.log('Could not copy text');
            });
        });
    </script>
}
