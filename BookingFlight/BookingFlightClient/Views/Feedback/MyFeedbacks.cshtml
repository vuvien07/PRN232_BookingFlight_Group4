@model List<BookingFlightClient.Models.ViewModels.FeedbackDisplayViewModel>

@{
    ViewData["Title"] = "Feedback của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/css/common/Footer.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/common/Header.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            margin-top: 9%;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .feedback-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .page-header {
            background: white;
            border-radius: 15px;
            padding: 40px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .page-subtitle {
            color: #666;
            font-size: 1.1rem;
        }

        .feedback-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .feedback-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
        }

        .feedback-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .feedback-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .feedback-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .feedback-meta {
            text-align: right;
        }

        .feedback-rating {
            display: flex;
            gap: 3px;
            margin-bottom: 8px;
            justify-content: flex-end;
        }

        .star {
            color: #ffc107;
            font-size: 1.1rem;
        }

        .star.empty {
            color: #ddd;
        }

        .feedback-date {
            color: #666;
            font-size: 0.9rem;
        }

        .feedback-content {
            color: #555;
            line-height: 1.6;
            margin-bottom: 20px;
            font-size: 1rem;
        }

        .feedback-footer {
            padding-top: 15px;
            border-top: 1px solid #e9ecef;
            font-size: 0.9rem;
            color: #666;
        }

        .actions-bar {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        .btn {
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: #667eea;
            color: white;
        }

        .btn-primary:hover {
            background: #5a6fd8;
            transform: translateY(-2px);
        }

        .btn-outline {
            background: transparent;
            color: #667eea;
            border: 2px solid #667eea;
        }

        .btn-outline:hover {
            background: #667eea;
            color: white;
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .empty-icon {
            font-size: 4rem;
            color: #ddd;
            margin-bottom: 20px;
        }

        .empty-title {
            font-size: 1.5rem;
            color: #666;
            margin-bottom: 10px;
        }

        .empty-subtitle {
            color: #999;
            margin-bottom: 30px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #667eea;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #666;
            font-size: 0.9rem;
        }

        @@media (max-width: 768px) {
            .feedback-container {
                padding: 15px;
            }

            .page-header {
                padding: 25px;
            }

            .page-title {
                font-size: 2rem;
            }

            .feedback-header {
                flex-direction: column;
                gap: 15px;
            }

            .feedback-meta {
                text-align: left;
            }

            .feedback-rating {
                justify-content: flex-start;
            }

            .actions-bar {
                flex-direction: column;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <partial name="~/Views/Common/_Header.cshtml" />

    <div class="feedback-container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-user-comment"></i>
                <span data-vn="Feedback của tôi" data-en="My Feedbacks" data-zh="我的反馈">Feedback của tôi</span>
            </h1>
            <p class="page-subtitle">
                <span data-vn="Quản lý và xem lại các feedback bạn đã gửi" data-en="Manage and review your submitted feedbacks" data-zh="管理和查看您提交的反馈">
                    Quản lý và xem lại các feedback bạn đã gửi
                </span>
            </p>
        </div>

        <div class="actions-bar">
            <a href="@Url.Action("Create", "Feedback")" class="btn btn-primary">
                <i class="fas fa-plus"></i>
                <span data-vn="Gửi Feedback mới" data-en="Send New Feedback" data-zh="发送新反馈">Gửi Feedback mới</span>
            </a>
            <a href="@Url.Action("Index", "Feedback")" class="btn btn-outline">
                <i class="fas fa-comments"></i>
                <span data-vn="Xem tất cả Feedback" data-en="View All Feedbacks" data-zh="查看所有反馈">Xem tất cả Feedback</span>
            </a>
            <a href="@Url.Action("Index", "BookingHistory")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i>
                <span data-vn="Quay lại lịch sử" data-en="Back to History" data-zh="返回历史">Quay lại lịch sử</span>
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number">@Model.Count</div>
                    <div class="stat-label">Tổng feedback</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">@Model.Average(f => f.Rate).ToString("F1")</div>
                    <div class="stat-label">Đánh giá TB</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">@Model.Count(f => f.Rate >= 4)</div>
                    <div class="stat-label">Đánh giá tốt</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">@(Model.OrderByDescending(f => f.CreateAt).First().CreateAt?.ToString("dd/MM") ?? "N/A")</div>
                    <div class="stat-label">Mới nhất</div>
                </div>
            </div>

            @foreach (var feedback in Model.OrderByDescending(f => f.CreateAt))
            {
                <div class="feedback-card">
                    <div class="feedback-header">
                        <div>
                            <h3 class="feedback-title">@feedback.Title</h3>
                        </div>
                        <div class="feedback-meta">
                            <div class="feedback-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star star @(i <= feedback.Rate ? "" : "empty")"></i>
                                }
                            </div>
                            <div class="feedback-date">@feedback.CreateAt?.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>

                    <div class="feedback-content">
                        @feedback.Content
                    </div>

                    <div class="feedback-footer">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <i class="fas fa-calendar"></i>
                                Đã gửi @feedback.CreateAt?.ToString("dd/MM/yyyy")
                            </div>
                            @if (!string.IsNullOrEmpty(feedback.TicketNumber))
                            {
                                <div>
                                    <i class="fas fa-ticket-alt"></i>
                                    Vé: @feedback.TicketNumber
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-comment-slash"></i>
                </div>
                <h3 class="empty-title">
                    <span data-vn="Bạn chưa gửi feedback nào" data-en="You haven't sent any feedback yet" data-zh="您还没有发送任何反馈">Bạn chưa gửi feedback nào</span>
                </h3>
                <p class="empty-subtitle">
                    <span data-vn="Chia sẻ trải nghiệm của bạn để giúp chúng tôi cải thiện dịch vụ" data-en="Share your experience to help us improve our service" data-zh="分享您的体验以帮助我们改善服务">
                        Chia sẻ trải nghiệm của bạn để giúp chúng tôi cải thiện dịch vụ
                    </span>
                </p>
                <a href="@Url.Action("Create", "Feedback")" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    <span data-vn="Gửi Feedback đầu tiên" data-en="Send First Feedback" data-zh="发送第一个反馈">Gửi Feedback đầu tiên</span>
                </a>
            </div>
        }
    </div>

    <partial name="~/Views/Common/_Footer.cshtml" />

    <script src="~/js/lib/bootstrap.bundle.min.js"></script>
    <script src="~/js/common/LanguageUtils.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.LanguageUtils) {
                window.LanguageUtils.updatePageLanguage();
            }
        });
    </script>
</body>
</html>
