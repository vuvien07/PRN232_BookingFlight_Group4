@model List<BookingFlightClient.Models.ViewModels.FeedbackDetailViewModel>

@{
    ViewData["Title"] = "Danh sách Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/css/common/Footer.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/common/Header.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            margin-top: 9%;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .feedback-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .page-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .page-title {
            font-size: 3rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .page-subtitle {
            font-size: 1.2rem;
            color: #666;
            margin-bottom: 30px;
        }

        .feedback-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-icon {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #666;
            font-size: 0.9rem;
        }

        .feedback-grid {
            display: grid;
            gap: 25px;
        }

        .feedback-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .feedback-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
        }

        .feedback-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .feedback-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .feedback-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .feedback-meta {
            text-align: right;
            color: #666;
            font-size: 0.9rem;
        }

        .feedback-rating {
            display: flex;
            gap: 3px;
            margin-bottom: 5px;
            justify-content: flex-end;
        }

        .star {
            color: #ffc107;
            font-size: 1rem;
        }

        .star.empty {
            color: #ddd;
        }

        .feedback-content {
            color: #555;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .flight-info {
            background: #f8f9fa;
            border-left: 4px solid #007bff;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .flight-info h4 {
            margin: 0 0 15px 0;
            color: #007bff;
            font-size: 1rem;
            font-weight: 600;
        }

        .flight-info h4 i {
            margin-right: 8px;
        }

        .flight-details {
            display: grid;
            gap: 8px;
        }

        .flight-detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .detail-label {
            font-weight: 500;
            color: #666;
            min-width: 110px;
        }

        .detail-value {
            font-weight: 600;
            color: #333;
            text-align: right;
        }

        .feedback-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 15px;
            border-top: 1px solid #e9ecef;
            font-size: 0.9rem;
            color: #666;
        }

        .feedback-author {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .author-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
        }

        .search-filter-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #e0e6ed;
        }

        .search-filter-form .form-group label {
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            display: block;
        }

        .search-filter-form .form-control {
            border: 2px solid #e0e6ed;
            border-radius: 8px;
            padding: 10px 15px;
            transition: all 0.3s ease;
        }

        .search-filter-form .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

        .search-filter-form .btn {
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 600;
        }

        .search-filter-form .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
        }

        .search-filter-form .btn-outline {
            background: transparent;
            color: #6c757d;
            border: 2px solid #e0e6ed;
        }

        .search-filter-form .btn-outline:hover {
            background: #f8f9fa;
            border-color: #adb5bd;
        }

        .feedback-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-bottom: 40px;
        }

        .btn {
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: #667eea;
            color: white;
        }

        .btn-primary:hover {
            background: #5a6fd8;
            transform: translateY(-2px);
        }

        .btn-outline {
            background: transparent;
            color: #667eea;
            border: 2px solid #667eea;
        }

        .btn-outline:hover {
            background: #667eea;
            color: white;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .empty-icon {
            font-size: 4rem;
            color: #ddd;
            margin-bottom: 20px;
        }

        .empty-title {
            font-size: 1.5rem;
            color: #666;
            margin-bottom: 10px;
        }

        .empty-subtitle {
            color: #999;
            margin-bottom: 30px;
        }

        /* Pagination Styles */
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 40px;
            padding: 25px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #e0e6ed;
        }

        .pagination {
            list-style: none;
            display: flex;
            gap: 5px;
            margin: 0;
            padding: 0;
        }

        .page-item {
            border-radius: 8px;
            overflow: hidden;
        }

        .page-item.disabled .page-link {
            background: #f8f9fa;
            color: #6c757d;
            border-color: #dee2e6;
            cursor: not-allowed;
        }

        .page-item.active .page-link,
        .page-item .page-link.current {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-color: #667eea;
            font-weight: 600;
        }

        .page-link {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 10px 15px;
            color: #667eea;
            text-decoration: none;
            background: white;
            border: 2px solid #e0e6ed;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
            min-width: 44px;
            justify-content: center;
        }

        .page-link:hover:not(.current) {
            background: #667eea;
            color: white;
            border-color: #667eea;
            transform: translateY(-2px);
        }

        .pagination-info {
            color: #666;
            font-size: 0.9rem;
        }

        .pagination-info strong {
            color: #333;
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .feedback-container {
                padding: 15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .feedback-header {
                flex-direction: column;
                gap: 15px;
            }

            .feedback-meta {
                text-align: left;
            }

            .feedback-rating {
                justify-content: flex-start;
            }

            .feedback-actions {
                flex-direction: column;
            }

            .pagination-container {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }

            .pagination {
                justify-content: center;
                flex-wrap: wrap;
            }

            .page-link {
                padding: 8px 12px;
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <partial name="~/Views/Common/_Header.cshtml" />

    <div class="feedback-container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-comments"></i>
                <span data-vn="Feedback từ khách hàng" data-en="Customer Feedback" data-zh="客户反馈">Feedback từ khách hàng</span>
            </h1>
            <p class="page-subtitle">
                <span data-vn="Những đánh giá và góp ý từ khách hàng" data-en="Reviews and suggestions from customers" data-zh="来自客户的评价和建议">
                    Những đánh giá và góp ý từ khách hàng
                </span>
            </p>
        </div>

        <!-- Alert Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius: 15px; border-left: 5px solid #28a745; background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%); margin-bottom: 30px;">
                <i class="fas fa-check-circle me-2" style="color: #28a745;"></i>
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: 15px; border-left: 5px solid #dc3545; background: linear-gradient(135deg, #f8d7da 0%, #f1b0b7 100%); margin-bottom: 30px;">
                <i class="fas fa-exclamation-circle me-2" style="color: #dc3545;"></i>
                <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="feedback-stats">
                <div class="stat-card">
                    <div class="stat-icon" style="color: #667eea;">
                        <i class="fas fa-comments"></i>
                    </div>
                    <div class="stat-number" style="color: #667eea;">@Model.Count</div>
                    <div class="stat-label">Tổng feedback</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="color: #28a745;">
                        <i class="fas fa-star"></i>
                    </div>
                    <div class="stat-number" style="color: #28a745;">@Model.Average(f => f.Rate).ToString("F1")</div>
                    <div class="stat-label">Đánh giá trung bình</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="color: #ffc107;">
                        <i class="fas fa-thumbs-up"></i>
                    </div>
                    <div class="stat-number" style="color: #ffc107;">@Model.Count(f => f.Rate >= 4)</div>
                    <div class="stat-label">Đánh giá tích cực</div>
                </div>
            </div>

            <!-- Search and Filter Form -->
            <div class="search-filter-section">
                <form method="get" action="@Url.Action("Index", "Feedback")" class="search-filter-form">
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="pageSize" value="@ViewBag.PageSize" />
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="searchText">
                                    <span data-vn="Tìm kiếm" data-en="Search" data-zh="搜索">Tìm kiếm</span>
                                </label>
                                <input type="text" class="form-control" id="searchText" name="searchText" 
                                       value="@ViewBag.SearchText" 
                                       placeholder="Tìm theo tiêu đề hoặc nội dung...">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="rating">
                                    <span data-vn="Lọc theo đánh giá" data-en="Filter by Rating" data-zh="按评分筛选">Lọc theo đánh giá</span>
                                </label>
                                <select class="form-control" id="rating" name="rating">
                                    <option value="">
                                        <span data-vn="Tất cả" data-en="All" data-zh="全部">Tất cả</span>
                                    </option>
                                    <option value="5" selected="@(ViewBag.Rating?.ToString() == "5" ? "selected" : null)">⭐⭐⭐⭐⭐ (5 sao)</option>
                                    <option value="4" selected="@(ViewBag.Rating?.ToString() == "4" ? "selected" : null)">⭐⭐⭐⭐ (4 sao)</option>
                                    <option value="3" selected="@(ViewBag.Rating?.ToString() == "3" ? "selected" : null)">⭐⭐⭐ (3 sao)</option>
                                    <option value="2" selected="@(ViewBag.Rating?.ToString() == "2" ? "selected" : null)">⭐⭐ (2 sao)</option>
                                    <option value="1" selected="@(ViewBag.Rating?.ToString() == "1" ? "selected" : null)">⭐ (1 sao)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <div class="d-flex">
                                    <button type="submit" class="btn btn-primary me-2">
                                        <i class="fas fa-search"></i>
                                        <span data-vn="Tìm kiếm" data-en="Search" data-zh="搜索">Tìm kiếm</span>
                                    </button>
                                    <a href="@Url.Action("Index", "Feedback")" class="btn btn-outline">
                                        <i class="fas fa-refresh"></i>
                                        <span data-vn="Xóa bộ lọc" data-en="Clear Filter" data-zh="清除筛选">Xóa bộ lọc</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="feedback-actions">
                <a href="@Url.Action("MyFeedbacks", "Feedback")" class="btn btn-outline">
                    <i class="fas fa-user"></i>
                    <span data-vn="Feedback của tôi" data-en="My Feedbacks" data-zh="我的反馈">Feedback của tôi</span>
                </a>
            </div>

            <div class="feedback-grid">
                @foreach (var feedback in Model.OrderByDescending(f => f.CreateAt))
                {
                    <div class="feedback-card">
                        <div class="feedback-header">
                            <div>
                                <h3 class="feedback-title">@feedback.Title</h3>
                            </div>
                            <div class="feedback-meta">
                                <div class="feedback-rating">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star star @(i <= feedback.Rate ? "" : "empty")"></i>
                                    }
                                </div>
                                <div>@feedback.CreateAt?.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>

                        <div class="feedback-content">
                            @feedback.Content
                        </div>

                        <!-- Thông tin chi tiết chuyến bay -->
                        <div class="flight-info">
                            <h4><i class="fas fa-plane"></i> Thông tin chuyến bay</h4>
                            <div class="flight-details">
                                <div class="flight-detail-row">
                                    <span class="detail-label">Mã chuyến bay:</span>
                                    <span class="detail-value">@feedback.FlightNumber</span>
                                </div>
                                <div class="flight-detail-row">
                                    <span class="detail-label">Lộ trình:</span>
                                    <span class="detail-value">@feedback.DepartureAirport → @feedback.ArrivalAirport</span>
                                </div>
                                <div class="flight-detail-row">
                                    <span class="detail-label">Ngày bay:</span>
                                    <span class="detail-value">@feedback.FlightDate.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="flight-detail-row">
                                    <span class="detail-label">Giờ bay:</span>
                                    <span class="detail-value">@feedback.DepartureTime.ToString("HH:mm") - @feedback.ArrivalTime.ToString("HH:mm")</span>
                                </div>
                            </div>
                        </div>

                        <div class="feedback-footer">
                            <div class="feedback-author">
                                <div class="author-avatar">
                                    @if (!string.IsNullOrEmpty(feedback.AccountName))
                                    {
                                        @feedback.AccountName.Substring(0, 1).ToUpper()
                                    }
                                    else
                                    {
                                        <i class="fas fa-user"></i>
                                    }
                                </div>
                                <span>@(string.IsNullOrEmpty(feedback.AccountName) ? "Khách hàng" : feedback.AccountName)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(feedback.TicketNumber))
                            {
                                <div>
                                    <i class="fas fa-ticket-alt"></i>
                                    @feedback.TicketNumber
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="pagination-container">
                    <nav aria-label="Pagination navigation">
                        <ul class="pagination">
                            <!-- Previous Page -->
                            @if (ViewBag.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { searchText = ViewBag.SearchText, rating = ViewBag.Rating, page = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize })">
                                        <i class="fas fa-chevron-left"></i>
                                        <span data-vn="Trước" data-en="Previous" data-zh="上一页">Trước</span>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">
                                        <i class="fas fa-chevron-left"></i>
                                        <span data-vn="Trước" data-en="Previous" data-zh="上一页">Trước</span>
                                    </span>
                                </li>
                            }

                            <!-- Page Numbers -->
                            @{
                                int totalPages = ViewBag.TotalPages;
                                int currentPage = ViewBag.CurrentPage;
                                int startPage = Math.Max(1, currentPage - 2);
                                int endPage = Math.Min(totalPages, currentPage + 2);
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { searchText = ViewBag.SearchText, rating = ViewBag.Rating, page = 1, pageSize = ViewBag.PageSize })">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    @if (i == currentPage)
                                    {
                                        <span class="page-link current">@i</span>
                                    }
                                    else
                                    {
                                        <a class="page-link" href="@Url.Action("Index", new { searchText = ViewBag.SearchText, rating = ViewBag.Rating, page = i, pageSize = ViewBag.PageSize })">@i</a>
                                    }
                                </li>
                            }

                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { searchText = ViewBag.SearchText, rating = ViewBag.Rating, page = totalPages, pageSize = ViewBag.PageSize })">@totalPages</a>
                                </li>
                            }

                            <!-- Next Page -->
                            @if (ViewBag.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { searchText = ViewBag.SearchText, rating = ViewBag.Rating, page = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize })">
                                        <span data-vn="Sau" data-en="Next" data-zh="下一页">Sau</span>
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">
                                        <span data-vn="Sau" data-en="Next" data-zh="下一页">Sau</span>
                                        <i class="fas fa-chevron-right"></i>
                                    </span>
                                </li>
                            }
                        </ul>
                    </nav>

                    <!-- Pagination Info -->
                    <div class="pagination-info">
                        <span data-vn="Hiển thị" data-en="Showing" data-zh="显示">Hiển thị</span>
                        <strong>@((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1)</strong>
                        -
                        <strong>@Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems)</strong>
                        <span data-vn="trong tổng số" data-en="of" data-zh="共">trong tổng số</span>
                        <strong>@ViewBag.TotalItems</strong>
                        <span data-vn="feedback" data-en="feedbacks" data-zh="反馈">feedback</span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-comment-slash"></i>
                </div>
                <h3 class="empty-title">
                    <span data-vn="Chưa có feedback nào" data-en="No feedback yet" data-zh="暂无反馈">Chưa có feedback nào</span>
                </h3>
                <p class="empty-subtitle">
                    <span data-vn="Hãy là người đầu tiên chia sẻ trải nghiệm của bạn!" data-en="Be the first to share your experience!" data-zh="成为第一个分享您体验的人！">
                        Hãy là người đầu tiên chia sẻ trải nghiệm của bạn!
                    </span>
                </p>
                <a href="@Url.Action("Create", "Feedback")" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    <span data-vn="Gửi Feedback đầu tiên" data-en="Send First Feedback" data-zh="发送第一个反馈">Gửi Feedback đầu tiên</span>
                </a>
            </div>
        }
    </div>

    <partial name="~/Views/Common/_Footer.cshtml" />

    <script src="~/js/lib/bootstrap.bundle.min.js"></script>
    <script src="~/js/common/LanguageUtils.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-hide alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                setTimeout(function() {
                    if (alert && alert.classList.contains('show')) {
                        alert.classList.remove('show');
                        alert.classList.add('fade');
                        setTimeout(function() {
                            if (alert.parentNode) {
                                alert.parentNode.removeChild(alert);
                            }
                        }, 500);
                    }
                }, 5000); // 5 seconds
            });

            if (window.LanguageUtils) {
                window.LanguageUtils.updatePageLanguage();
            }
        });
    </script>
</body>
</html>
