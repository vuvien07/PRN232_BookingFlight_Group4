@{
    ViewData["Title"] = "Manage Flights";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="flight-manage-container">
    <!-- Header Section -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="page-title">Flight Management</h2>
                <p class="page-subtitle">Manage your flight schedules with AI-powered conflict detection</p>
            </div>
            <div class="col-md-4 text-end">
                <button class="btn btn-primary" onclick="showAddFlightModal()">
                    <i class="fas fa-plus"></i> Add New Flight
                </button>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="filter-section">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label class="form-label">Search</label>
                        <input type="text" class="form-control" id="searchInput" placeholder="Flight code, airport...">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="statusFilter">
                            <option value="">All Status</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Departure From</label>
                        <input type="date" class="form-control" id="departureFrom">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Departure To</label>
                        <input type="date" class="form-control" id="departureTo">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary" onclick="applyFilters()">
                                <i class="fas fa-search"></i> Search
                            </button>
                            <button class="btn btn-outline-secondary" onclick="clearFilters()">
                                <i class="fas fa-times"></i> Clear
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Flights Table -->
    <div class="flights-table-section">
        <div class="card">
            <div class="card-header">
                <h6 class="card-title mb-0">Flight List</h6>
            </div>
            <div class="card-body">
                <div id="loadingSpinner" class="text-center p-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading flights...</p>
                </div>

                <div id="flightsTableContainer">
                    <table class="table table-hover" id="flightsTable">
                        <thead>
                            <tr>
                                <th>Flight Code</th>
                                <th>Route</th>
                                <th>Departure</th>
                                <th>Arrival</th>
                                <th>Plane</th>
                                <th>Status</th>
                                <th>Seats</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="flightsTableBody">
                            <!-- Dynamic content -->
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <nav aria-label="Flight pagination" id="paginationContainer" style="display: none;">
                    <ul class="pagination justify-content-center" id="pagination">
                        <!-- Dynamic pagination -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Flight Modal -->
<div class="modal fade" id="flightModal" tabindex="-1" aria-labelledby="flightModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="flightModalLabel">Add New Flight</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="flightForm">
                <div class="modal-body">
                    <div id="conflictAlert" class="alert alert-warning" style="display: none;">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="alert-heading">Flight Schedule Conflicts Detected</h6>
                                <div id="conflictDetails"></div>
                                <div id="aiAnalysis" class="mt-3">
                                    <h6>AI Recommendations:</h6>
                                    <div id="aiRecommendations"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="flightCode" class="form-label">Flight Code *</label>
                                <input type="text" class="form-control" id="flightCode" name="flightCode" required>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="tax" class="form-label">Tax (%) *</label>
                                <input type="number" class="form-control" id="tax" name="tax" min="0" max="100" step="0.01" required>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="departureTime" class="form-label">Departure Time *</label>
                                <input type="datetime-local" class="form-control" id="departureTime" name="departureTime" required>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="arrivalTime" class="form-label">Arrival Time *</label>
                                <input type="datetime-local" class="form-control" id="arrivalTime" name="arrivalTime" required>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="departureAirportId" class="form-label">Departure Airport *</label>
                                <select class="form-select" id="departureAirportId" name="departureAirportId" required>
                                    <option value="">Select Departure Airport</option>
                                </select>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="arrivalAirportId" class="form-label">Arrival Airport *</label>
                                <select class="form-select" id="arrivalAirportId" name="arrivalAirportId" required>
                                    <option value="">Select Arrival Airport</option>
                                </select>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="planeId" class="form-label">Aircraft *</label>
                                <select class="form-select" id="planeId" name="planeId" required>
                                    <option value="">Select Aircraft</option>
                                </select>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="serviceIds" class="form-label">Services (Optional)</label>
                                <select class="form-select" id="serviceIds" name="serviceIds" multiple>
                                    <!-- Services will be loaded here -->
                                </select>
                                <small class="form-text text-muted">Hold Ctrl to select multiple services</small>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Status field only for edit mode -->
                    <div class="row" id="statusGroup" style="display: none;">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="statusId" class="form-label">Status</label>
                                <select class="form-select" id="statusId" name="statusId">
                                    <!-- Status options will be loaded here -->
                                </select>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-info" onclick="checkConflicts()">
                            <i class="fas fa-search"></i> Check Conflicts with AI
                        </button>
                        <small class="text-muted">AI will analyze potential scheduling conflicts</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveFlightBtn">
                        <i class="fas fa-save"></i> Save Flight
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Change Status Confirmation Modal -->
<div class="modal fade" id="statusChangeConfirmModal" tabindex="-1" aria-labelledby="statusChangeConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusChangeConfirmModalLabel">Confirm Status Change</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="statusChangeMessage">Are you sure you want to change the status of this flight?</p>
                <p><strong id="statusChangeFlightInfo"></strong></p>
                <p class="text-info">
                    <i class="fas fa-info-circle"></i>
                    <span id="statusChangeNote">This will update the flight's availability status.</span>
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmStatusChangeBtn">
                    <i class="fas fa-sync"></i> <span id="statusChangeButtonText">Change Status</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Flight Seats Management Modal -->
<div class="modal fade" id="flightSeatsModal" tabindex="-1" aria-labelledby="flightSeatsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="flightSeatsModalLabel">Manage Flight Seats</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Current Flight Seats -->
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Current Flight Seats</h6>
                                <div>
                                    <button class="btn btn-sm btn-outline-primary" onclick="regenerateAllSeats()">
                                        <i class="fas fa-sync"></i> Regenerate All
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Seat Number</th>
                                                <th>Class</th>
                                                <th>Status</th>
                                                <th>Occupied</th>
                                                <th>Ticket</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="flightSeatsTableBody">
                                            <!-- Flight seats will be loaded here -->
                                        </tbody>
                                    </table>
                                </div>
                                <div id="flightSeatsLoadingText" class="text-center text-muted">
                                    Loading flight seats...
                                </div>
                                <div id="flightSeatsEmptyText" class="text-center text-muted" style="display: none;">
                                    No flight seats found. Click "Regenerate All" to create seats automatically.
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Add New Seat -->
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">Add Individual Seat</h6>
                            </div>
                            <div class="card-body">
                                <form id="addFlightSeatForm">
                                    <div class="mb-3">
                                        <label class="form-label">Available Seats</label>
                                        <select class="form-select" id="availableSeatSelect" required>
                                            <option value="">Select a seat...</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="seatOccupied">
                                            <label class="form-check-label" for="seatOccupied">
                                                Mark as occupied
                                            </label>
                                        </div>
                                    </div>
                                    <div class="mb-3" id="ticketIdGroup" style="display: none;">
                                        <label class="form-label">Ticket ID</label>
                                        <input type="number" class="form-control" id="ticketIdInput" placeholder="Enter ticket ID">
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-plus"></i> Add Seat
                                    </button>
                                </form>
                                
                                <div class="mt-3" id="availableSeatsInfo">
                                    <!-- Available seats info will be shown here -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/manager-flights.js"></script>
}

<style>
.flight-manage-container {
    padding: 20px;
}

.page-header {
    margin-bottom: 20px;
}

.page-title {
    color: #2c3e50;
    font-weight: 600;
}

.page-subtitle {
    color: #7f8c8d;
    margin-bottom: 0;
}

.filter-section {
    margin-bottom: 20px;
}

.flights-table-section .card {
    border: none;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

.table th {
    background-color: #f8f9fa;
    border-top: none;
    font-weight: 600;
    color: #2c3e50;
}

.badge {
    font-size: 0.75em;
}

.btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
}

#conflictAlert {
    border-left: 4px solid #f39c12;
}

.modal-xl {
    max-width: 1200px;
}

@@media (max-width: 768px) {
    .flight-manage-container {
        padding: 10px;
    }
    
    .page-header .col-md-4 {
        margin-top: 15px;
        text-align: left !important;
    }
    
    .filter-section .row > div {
        margin-bottom: 15px;
    }
    
    .modal-xl {
        max-width: 95%;
    }
}
</style>
