@{
    ViewData["Title"] = "Flight Details";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="flight-details-container">
    <!-- Header Section -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="page-title">Flight Details</h2>
                <p class="page-subtitle" id="flightCodeTitle">Loading flight information...</p>
            </div>
            <div class="col-md-4 text-end">
                <button class="btn btn-outline-secondary me-2" onclick="window.history.back()">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                <button class="btn btn-primary" onclick="showEditFlightModal()">
                    <i class="fas fa-edit"></i> Edit Flight
                </button>
            </div>
        </div>
    </div>

    <!-- Flight Information -->
    <div class="row">
        <div class="col-md-8">
            <!-- Basic Flight Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="fas fa-plane"></i> Flight Information</h5>
                </div>
                <div class="card-body" id="flightInfo">
                    <!-- Flight info will be loaded here -->
                </div>
            </div>

            <!-- Services Section -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="fas fa-concierge-bell"></i> Flight Services</h5>
                    <button class="btn btn-sm btn-primary" onclick="showAddServiceModal()">
                        <i class="fas fa-plus"></i> Add Service
                    </button>
                </div>
                <div class="card-body">
                    <div id="servicesContainer">
                        <!-- Services will be loaded here -->
                    </div>
                </div>
            </div>

            <!-- Flight Seats Section -->
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="fas fa-chair"></i> Seat Map</h5>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" onclick="refreshSeatMap()">
                            <i class="fas fa-sync"></i> Refresh
                        </button>
                        <button class="btn btn-sm btn-warning" onclick="regenerateSeats()">
                            <i class="fas fa-redo"></i> Regenerate Seats
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Seat Legend -->
                    <div class="seat-legend mb-3">
                        <div class="d-flex gap-4">
                            <div class="legend-item">
                                <span class="seat-indicator available"></span> Available
                            </div>
                            <div class="legend-item">
                                <span class="seat-indicator occupied"></span> Occupied
                            </div>
                            <div class="legend-item">
                                <span class="seat-indicator selected"></span> Selected
                            </div>
                        </div>
                    </div>
                    
                    <!-- Seat Map -->
                    <div id="seatMapContainer">
                        <!-- Seat map will be loaded here -->
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Flight Statistics -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="fas fa-chart-bar"></i> Statistics</h5>
                </div>
                <div class="card-body" id="flightStats">
                    <!-- Statistics will be loaded here -->
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-bolt"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-primary" onclick="viewTickets()">
                            <i class="fas fa-ticket-alt"></i> View Tickets
                        </button>
                        <button class="btn btn-outline-info" onclick="exportSeatMap()">
                            <i class="fas fa-download"></i> Export Seat Map
                        </button>
                        <button class="btn btn-outline-success" onclick="viewRevenue()">
                            <i class="fas fa-dollar-sign"></i> View Revenue
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Service to Flight</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addServiceForm">
                    <div class="mb-3">
                        <label class="form-label">Select Service</label>
                        <select class="form-select" id="serviceSelect" required>
                            <option value="">Choose a service...</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="addServiceToFlight()">Add Service</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Flight Modal -->
<div class="modal fade" id="editFlightModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Flight</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editFlightForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Flight Code</label>
                                <input type="text" class="form-control" id="editFlightCode" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Tax (%)</label>
                                <input type="number" class="form-control" id="editTax" step="0.01" min="0" max="100" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Departure Time</label>
                                <input type="datetime-local" class="form-control" id="editDepartureTime" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Arrival Time</label>
                                <input type="datetime-local" class="form-control" id="editArrivalTime" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Aircraft</label>
                                <select class="form-select" id="editPlaneId" required>
                                    <option value="">Select Aircraft</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Departure Airport</label>
                                <select class="form-select" id="editDepartureAirportId" required>
                                    <option value="">Select Airport</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Arrival Airport</label>
                                <select class="form-select" id="editArrivalAirportId" required>
                                    <option value="">Select Airport</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Status</label>
                                <select class="form-select" id="editStatusId" required>
                                    <option value="">Select Status</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Services</label>
                                <select class="form-select" id="editServicesSelect" multiple>
                                    <!-- Services will be loaded here -->
                                </select>
                                <small class="form-text text-muted">Hold Ctrl to select multiple services</small>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateFlight()">Update Flight</button>
            </div>
        </div>
    </div>
</div>

<style>
.flight-details-container {
    padding: 20px;
}

.page-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid #dee2e6;
}

.page-title {
    color: #2c3e50;
    font-weight: 600;
    margin-bottom: 5px;
}

.page-subtitle {
    color: #6c757d;
    margin-bottom: 0;
}

/* Flight Info Styles */
.flight-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.info-item {
    display: flex;
    flex-direction: column;
}

.info-label {
    font-size: 0.85rem;
    color: #6c757d;
    font-weight: 500;
    margin-bottom: 5px;
}

.info-value {
    font-size: 1rem;
    color: #2c3e50;
    font-weight: 600;
}

/* Service Styles */
.service-item {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 10px;
    display: flex;
    justify-content-between;
    align-items-center;
    transition: all 0.3s ease;
}

.service-item:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.service-info h6 {
    margin-bottom: 5px;
    color: #2c3e50;
}

.service-info p {
    margin-bottom: 0;
    color: #6c757d;
    font-size: 0.9rem;
}

/* Seat Map Styles */
.seat-legend {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-bottom: 20px;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
}

.seat-indicator {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 2px solid #dee2e6;
}

.seat-indicator.available {
    background-color: #28a745;
}

.seat-indicator.occupied {
    background-color: #dc3545;
}

.seat-indicator.selected {
    background-color: #007bff;
}

.seat-map {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    max-width: 400px;
    margin: 0 auto;
}

.seat {
    width: 45px;
    height: 45px;
    border: 2px solid #dee2e6;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
}

.seat.available {
    background-color: #d4edda;
    border-color: #28a745;
    color: #155724;
}

.seat.occupied {
    background-color: #f8d7da;
    border-color: #dc3545;
    color: #721c24;
    cursor: not-allowed;
}

.seat.business {
    border-width: 3px;
}

.seat.economy {
    border-width: 2px;
}

.seat.first {
    border-width: 4px;
    border-style: double;
}

/* Statistics Styles */
.stat-item {
    text-align: center;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 15px;
}

.stat-item.primary {
    background-color: #e3f2fd;
    color: #1565c0;
}

.stat-item.success {
    background-color: #e8f5e8;
    color: #2e7d32;
}

.stat-item.warning {
    background-color: #fff3cd;
    color: #b58900;
}

.stat-number {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 5px;
}

.stat-label {
    font-size: 0.9rem;
    font-weight: 500;
}

/* Responsive */
@@media (max-width: 768px) {
    .flight-info-grid {
        grid-template-columns: 1fr;
    }
    
    .seat-map {
        grid-template-columns: repeat(4, 1fr);
    }
    
    .seat {
        width: 35px;
        height: 35px;
        font-size: 0.7rem;
    }
}
</style>

<script>
let currentFlightId = null;
let currentFlightData = null;

// Get flight ID from URL
document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    currentFlightId = urlParams.get('id');
    
    if (!currentFlightId) {
        alert('Flight ID not provided');
        window.history.back();
        return;
    }
    
    loadFlightDetails();
    loadAvailableServices();
    loadFormData();
});

async function loadFlightDetails() {
    try {
        showLoadingSpinner();
        
        const response = await fetch(`/api/FlightManage/${currentFlightId}`, {
            headers: {
                'Authorization': `Bearer ${getAuthToken()}`
            }
        });
        
        if (!response.ok) {
            throw new Error('Failed to load flight details');
        }
        
        const result = await response.json();
        if (result.success) {
            currentFlightData = result.data;
            displayFlightInfo(result.data);
            displayServices(result.data.services);
            displaySeatMap(result.data.flightSeats);
            displayStatistics(result.data);
        } else {
            throw new Error(result.message);
        }
    } catch (error) {
        console.error('Error loading flight details:', error);
        showAlert('Error loading flight details: ' + error.message, 'danger');
    } finally {
        hideLoadingSpinner();
    }
}

function displayFlightInfo(flight) {
    document.getElementById('flightCodeTitle').textContent = `${flight.flightCode} - ${flight.departureAirportCode} to ${flight.arrivalAirportCode}`;
    
    const flightInfoHtml = `
        <div class="flight-info-grid">
            <div class="info-item">
                <span class="info-label">Flight Code</span>
                <span class="info-value">${flight.flightCode}</span>
            </div>
            <div class="info-item">
                <span class="info-label">Aircraft</span>
                <span class="info-value">${flight.planeName || 'N/A'}</span>
            </div>
            <div class="info-item">
                <span class="info-label">Status</span>
                <span class="info-value">
                    <span class="badge bg-${getStatusBadgeClass(flight.statusId)}">${flight.statusName}</span>
                </span>
            </div>
            <div class="info-item">
                <span class="info-label">Tax</span>
                <span class="info-value">${flight.tax}%</span>
            </div>
            <div class="info-item">
                <span class="info-label">Departure</span>
                <span class="info-value">${formatDateTime(flight.departureTime)}</span>
            </div>
            <div class="info-item">
                <span class="info-label">Arrival</span>
                <span class="info-value">${formatDateTime(flight.arrivalTime)}</span>
            </div>
            <div class="info-item">
                <span class="info-label">From</span>
                <span class="info-value">${flight.departureAirportName} (${flight.departureAirportCode})</span>
            </div>
            <div class="info-item">
                <span class="info-label">To</span>
                <span class="info-value">${flight.arrivalAirportName} (${flight.arrivalAirportCode})</span>
            </div>
            <div class="info-item">
                <span class="info-label">Base Price</span>
                <span class="info-value">${formatCurrency(flight.basePrice)}</span>
            </div>
            <div class="info-item">
                <span class="info-label">Manager</span>
                <span class="info-value">${flight.managerName || 'N/A'}</span>
            </div>
        </div>
    `;
    
    document.getElementById('flightInfo').innerHTML = flightInfoHtml;
}

function displayServices(services) {
    const container = document.getElementById('servicesContainer');
    
    if (!services || services.length === 0) {
        container.innerHTML = '<p class="text-muted text-center">No services added to this flight.</p>';
        return;
    }
    
    const servicesHtml = services.map(service => `
        <div class="service-item">
            <div class="service-info">
                <h6>${service.serviceName}</h6>
                <p>${service.detail || 'No description available'}</p>
                <small class="text-muted">Manager: ${service.managerName || 'N/A'}</small>
            </div>
            <div class="service-actions">
                <button class="btn btn-sm btn-outline-danger" onclick="removeService(${service.serviceId})">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
    `).join('');
    
    container.innerHTML = servicesHtml;
}

function displaySeatMap(seats) {
    const container = document.getElementById('seatMapContainer');
    
    if (!seats || seats.length === 0) {
        container.innerHTML = '<p class="text-muted text-center">No seats available for this flight.</p>';
        return;
    }
    
    // Group seats by class for better display
    const seatsByClass = seats.reduce((acc, seat) => {
        if (!acc[seat.className]) {
            acc[seat.className] = [];
        }
        acc[seat.className].push(seat);
        return acc;
    }, {});
    
    let seatMapHtml = '';
    
    Object.keys(seatsByClass).forEach(className => {
        const classSeats = seatsByClass[className];
        
        seatMapHtml += `
            <div class="mb-4">
                <h6 class="mb-3">${className} Class</h6>
                <div class="seat-map">
                    ${classSeats.map(seat => `
                        <div class="seat ${seat.isSat ? 'occupied' : 'available'} ${className.toLowerCase()}" 
                             data-seat-id="${seat.seatId}"
                             data-seat-number="${seat.seatNumber}"
                             data-is-sat="${seat.isSat}"
                             onclick="toggleSeat(${seat.seatId}, '${seat.seatNumber}', ${seat.isSat})">
                            ${seat.seatNumber}
                            ${seat.ticketCode ? `<br><small>${seat.ticketCode}</small>` : ''}
                        </div>
                    `).join('')}
                </div>
            </div>
        `;
    });
    
    container.innerHTML = seatMapHtml;
}

function displayStatistics(flight) {
    const statsHtml = `
        <div class="stat-item primary">
            <div class="stat-number">${flight.totalSeats}</div>
            <div class="stat-label">Total Seats</div>
        </div>
        <div class="stat-item success">
            <div class="stat-number">${flight.bookedSeats}</div>
            <div class="stat-label">Booked Seats</div>
        </div>
        <div class="stat-item warning">
            <div class="stat-number">${flight.availableSeats}</div>
            <div class="stat-label">Available Seats</div>
        </div>
        <div class="stat-item primary">
            <div class="stat-number">${flight.services ? flight.services.length : 0}</div>
            <div class="stat-label">Services</div>
        </div>
        <div class="stat-item success">
            <div class="stat-number">${Math.round((flight.bookedSeats / flight.totalSeats) * 100)}%</div>
            <div class="stat-label">Occupancy Rate</div>
        </div>
    `;
    
    document.getElementById('flightStats').innerHTML = statsHtml;
}

// Load available services for dropdown
async function loadAvailableServices() {
    try {
        const response = await fetch('/api/FlightManage/services', {
            headers: {
                'Authorization': `Bearer ${getAuthToken()}`
            }
        });
        
        if (response.ok) {
            const result = await response.json();
            if (result.success) {
                populateServiceDropdown(result.data);
            }
        }
    } catch (error) {
        console.error('Error loading available services:', error);
    }
}

function populateServiceDropdown(services) {
    const select = document.getElementById('serviceSelect');
    select.innerHTML = '<option value="">Choose a service...</option>';
    
    services.forEach(service => {
        // Only show services not already added to the flight
        const isAlreadyAdded = currentFlightData?.services?.some(s => s.serviceId === service.serviceId);
        if (!isAlreadyAdded) {
            select.innerHTML += `<option value="${service.serviceId}">${service.serviceName}</option>`;
        }
    });
}

// Service Management
function showAddServiceModal() {
    loadAvailableServices(); // Refresh the list
    const modal = new bootstrap.Modal(document.getElementById('addServiceModal'));
    modal.show();
}

async function addServiceToFlight() {
    const serviceId = document.getElementById('serviceSelect').value;
    
    if (!serviceId) {
        showAlert('Please select a service', 'warning');
        return;
    }
    
    try {
        const response = await fetch(`/api/FlightManage/${currentFlightId}/services`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${getAuthToken()}`
            },
            body: JSON.stringify({ serviceId: parseInt(serviceId) })
        });
        
        const result = await response.json();
        
        if (result.success) {
            showAlert('Service added successfully', 'success');
            bootstrap.Modal.getInstance(document.getElementById('addServiceModal')).hide();
            loadFlightDetails(); // Refresh the page
        } else {
            showAlert(result.message, 'danger');
        }
    } catch (error) {
        console.error('Error adding service:', error);
        showAlert('Error adding service', 'danger');
    }
}

async function removeService(serviceId) {
    if (!confirm('Are you sure you want to remove this service from the flight?')) {
        return;
    }
    
    try {
        const response = await fetch(`/api/FlightManage/${currentFlightId}/services/${serviceId}`, {
            method: 'DELETE',
            headers: {
                'Authorization': `Bearer ${getAuthToken()}`
            }
        });
        
        const result = await response.json();
        
        if (result.success) {
            showAlert('Service removed successfully', 'success');
            loadFlightDetails(); // Refresh the page
        } else {
            showAlert(result.message, 'danger');
        }
    } catch (error) {
        console.error('Error removing service:', error);
        showAlert('Error removing service', 'danger');
    }
}

// Seat Management
function toggleSeat(seatId, seatNumber, isCurrentlyOccupied) {
    // For now, just show seat info
    alert(`Seat ${seatNumber}\nStatus: ${isCurrentlyOccupied ? 'Occupied' : 'Available'}\nSeat ID: ${seatId}`);
    
    // In a real implementation, you might want to show a modal to edit seat status
    // or implement booking functionality
}

async function regenerateSeats() {
    if (!confirm('This will regenerate all flight seats based on the current aircraft configuration. Booked seats will be preserved. Continue?')) {
        return;
    }
    
    try {
        const response = await fetch(`/api/FlightManage/${currentFlightId}/seats/regenerate`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${getAuthToken()}`
            }
        });
        
        const result = await response.json();
        
        if (result.success) {
            showAlert('Seats regenerated successfully', 'success');
            loadFlightDetails(); // Refresh the page
        } else {
            showAlert(result.message, 'danger');
        }
    } catch (error) {
        console.error('Error regenerating seats:', error);
        showAlert('Error regenerating seats', 'danger');
    }
}

function refreshSeatMap() {
    loadFlightDetails();
}

// Edit Flight
function showEditFlightModal() {
    if (!currentFlightData) {
        showAlert('Flight data not loaded', 'warning');
        return;
    }
    
    // Populate form with current data
    document.getElementById('editFlightCode').value = currentFlightData.flightCode;
    document.getElementById('editTax').value = currentFlightData.tax;
    document.getElementById('editDepartureTime').value = formatDateTimeForInput(currentFlightData.departureTime);
    document.getElementById('editArrivalTime').value = formatDateTimeForInput(currentFlightData.arrivalTime);
    document.getElementById('editPlaneId').value = currentFlightData.planeId;
    document.getElementById('editDepartureAirportId').value = currentFlightData.departureAirportId;
    document.getElementById('editArrivalAirportId').value = currentFlightData.arrivalAirportId;
    document.getElementById('editStatusId').value = currentFlightData.statusId;
    
    // Set selected services
    const serviceIds = currentFlightData.services.map(s => s.serviceId);
    Array.from(document.getElementById('editServicesSelect').options).forEach(option => {
        option.selected = serviceIds.includes(parseInt(option.value));
    });
    
    const modal = new bootstrap.Modal(document.getElementById('editFlightModal'));
    modal.show();
}

async function updateFlight() {
    const formData = {
        flightId: currentFlightId,
        flightCode: document.getElementById('editFlightCode').value,
        tax: parseFloat(document.getElementById('editTax').value),
        departureTime: document.getElementById('editDepartureTime').value,
        arrivalTime: document.getElementById('editArrivalTime').value,
        planeId: parseInt(document.getElementById('editPlaneId').value),
        departureAirportId: parseInt(document.getElementById('editDepartureAirportId').value),
        arrivalAirportId: parseInt(document.getElementById('editArrivalAirportId').value),
        statusId: parseInt(document.getElementById('editStatusId').value),
        serviceIds: Array.from(document.getElementById('editServicesSelect').selectedOptions).map(option => parseInt(option.value))
    };
    
    try {
        const response = await fetch(`/api/FlightManage/${currentFlightId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${getAuthToken()}`
            },
            body: JSON.stringify(formData)
        });
        
        const result = await response.json();
        
        if (result.success) {
            showAlert('Flight updated successfully', 'success');
            bootstrap.Modal.getInstance(document.getElementById('editFlightModal')).hide();
            loadFlightDetails(); // Refresh the page
        } else {
            showAlert(result.message, 'danger');
        }
    } catch (error) {
        console.error('Error updating flight:', error);
        showAlert('Error updating flight', 'danger');
    }
}

