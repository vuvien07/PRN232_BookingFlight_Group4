@{
    ViewData["Title"] = "Flight Details";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@section Styles {
    <style>
        .stats-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }
        
        .stats-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }
        
        .nav-pills .nav-link {
            border-radius: 25px;
            margin-right: 10px;
            padding: 10px 20px;
            transition: all 0.3s ease;
        }
        
        .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #007bff, #0056b3);
            box-shadow: 0 4px 15px rgba(0,123,255,0.3);
        }
        
        .timeline-item {
            border-left: 3px solid #e9ecef;
            position: relative;
            padding-left: 20px;
            margin-bottom: 20px;
        }
        
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -6px;
            top: 0;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #007bff;
        }
        
        .seat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(50px, 1fr));
            gap: 5px;
            max-height: 300px;
            overflow-y: auto;
        }
        
        .seat-item {
            aspect-ratio: 1;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .seat-item.occupied {
            background: #dc3545;
            color: white;
            border-color: #dc3545;
        }
        
        .seat-item.available {
            background: #28a745;
            color: white;
            border-color: #28a745;
        }
        
        .seat-item:hover {
            transform: scale(1.1);
        }
        
        .modal-header {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            border-bottom: none;
        }
        
        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }
        
        .btn-gradient {
            background: linear-gradient(135deg, #007bff, #0056b3);
            border: none;
            color: white;
            transition: all 0.3s ease;
        }
        
        .btn-gradient:hover {
            background: linear-gradient(135deg, #0056b3, #004085);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,123,255,0.3);
            color: white;
        }
        
        .table-hover tbody tr:hover {
            background: rgba(0,123,255,0.05);
        }
        
        .badge {
            font-size: 0.8rem;
            padding: 0.5rem 0.8rem;
        }
        
        .nav-tabs .nav-link {
            border: none;
            border-bottom: 3px solid transparent;
            background: none;
            color: #6c757d;
            font-weight: 500;
            padding: 1rem 1.5rem;
            margin-right: 1rem;
            transition: all 0.3s ease;
        }
        
        .nav-tabs .nav-link:hover {
            border-color: #007bff;
            color: #007bff;
            background: rgba(0,123,255,0.05);
        }
        
        .nav-tabs .nav-link.active {
            border-bottom: 2px solid #007bff;
            color: #007bff;
        }
        
        .icon-circle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .flight-timeline {
            position: relative;
            padding: 20px 0;
        }

        .timeline-marker {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 15px;
            flex-shrink: 0;
        }

        .timeline-line {
            position: absolute;
            left: 5px;
            top: 32px;
            bottom: 32px;
            width: 2px;
            background: #dee2e6;
        }

        .timeline-content {
            flex: 1;
        }

        .seat-occupied {
            background-color: #f8d7da !important;
        }

        .seat-available {
            background-color: #d1f2eb !important;
        }

        .service-card {
            border-left: 4px solid #007bff;
            transition: transform 0.2s;
        }

        .service-card:hover {
            transform: translateY(-2px);
        }
    </style>
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">
                        <i class="fas fa-plane text-primary"></i> Flight Details
                    </h2>
                    <p class="text-muted mb-0">Comprehensive flight information and management</p>
                </div>
                <div>
                    <button class="btn btn-outline-secondary" onclick="goBack()">
                        <i class="fas fa-arrow-left"></i> Back to Flights
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading flight details...</p>
    </div>

    <!-- Flight Details Content -->
    <div id="flightDetailsContent" class="d-none">
        <!-- Flight Basic Info Card -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-info-circle"></i> Flight Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-primary">Basic Details</h6>
                                <table class="table table-borderless">
                                    <tbody id="flightBasicInfo">
                                        <!-- Flight basic info will be loaded here -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-primary">Route Information</h6>
                                <div id="routeInfo" class="mb-3">
                                    <!-- Route info will be loaded here -->
                                </div>
                                <div class="flight-timeline">
                                    <div class="timeline-item">
                                        <div class="timeline-marker bg-success"></div>
                                        <div class="timeline-content">
                                            <small class="text-muted">Departure</small>
                                            <div id="departureInfo"></div>
                                        </div>
                                    </div>
                                    <div class="timeline-line"></div>
                                    <div class="timeline-item">
                                        <div class="timeline-marker bg-danger"></div>
                                        <div class="timeline-content">
                                            <small class="text-muted">Arrival</small>
                                            <div id="arrivalInfo"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="icon-circle bg-primary bg-opacity-10 mx-auto mb-3">
                            <i class="fas fa-chair text-primary fs-4"></i>
                        </div>
                        <h5 class="card-title" id="totalSeats">0</h5>
                        <p class="card-text text-muted mb-0">Total Seats</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="icon-circle bg-success bg-opacity-10 mx-auto mb-3">
                            <i class="fas fa-user-check text-success fs-4"></i>
                        </div>
                        <h5 class="card-title" id="occupiedSeats">0</h5>
                        <p class="card-text text-muted mb-0">Occupied Seats</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="icon-circle bg-info bg-opacity-10 mx-auto mb-3">
                            <i class="fas fa-percentage text-info fs-4"></i>
                        </div>
                        <h5 class="card-title" id="occupancyRate">0%</h5>
                        <p class="card-text text-muted mb-0">Occupancy Rate</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="icon-circle bg-warning bg-opacity-10 mx-auto mb-3">
                            <i class="fas fa-dollar-sign text-warning fs-4"></i>
                        </div>
                        <h5 class="card-title" id="totalRevenue">$0</h5>
                        <p class="card-text text-muted mb-0">Total Revenue</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seats and Services Tabs -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <ul class="nav nav-tabs card-header-tabs" id="detailsTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="seats-tab" data-bs-toggle="tab" 
                                        data-bs-target="#seats-pane" type="button" role="tab">
                                    <i class="fas fa-chair"></i> Seats Management
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="services-tab" data-bs-toggle="tab" 
                                        data-bs-target="#services-pane" type="button" role="tab">
                                    <i class="fas fa-concierge-bell"></i> Services
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="analytics-tab" data-bs-toggle="tab" 
                                        data-bs-target="#analytics-pane" type="button" role="tab">
                                    <i class="fas fa-chart-bar"></i> Analytics
                                </button>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content" id="detailsTabContent">
                            <!-- Seats Tab -->
                            <div class="tab-pane fade show active" id="seats-pane" role="tabpanel">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0">Flight Seats</h6>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="manageFlightSeats()">
                                            <i class="fas fa-cog"></i> Manage Seats
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-success" onclick="refreshSeats()">
                                            <i class="fas fa-sync-alt"></i> Refresh
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Seat Class Filter -->
                                <div class="mb-3">
                                    <div class="btn-group" role="group" id="seatClassFilter">
                                        <button type="button" class="btn btn-outline-secondary active" data-class="all">
                                            All Classes
                                        </button>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Seat Number</th>
                                                <th>Class</th>
                                                <th>Price</th>
                                                <th>Status</th>
                                                <th>Customer</th>
                                                <th>Ticket Number</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="seatsTableBody">
                                            <!-- Seats data will be loaded here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Services Tab -->
                            <div class="tab-pane fade" id="services-pane" role="tabpanel">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0">Flight Services</h6>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="manageFlightServices()">
                                        <i class="fas fa-plus"></i> Manage Services
                                    </button>
                                </div>
                                
                                <div class="row" id="servicesContainer">
                                    <!-- Services will be loaded here -->
                                </div>
                            </div>

                            <!-- Analytics Tab -->
                            <div class="tab-pane fade" id="analytics-pane" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-header">
                                                <h6 class="mb-0">Seat Distribution by Class</h6>
                                            </div>
                                            <div class="card-body">
                                                <canvas id="seatDistributionChart" width="400" height="300"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-header">
                                                <h6 class="mb-0">Revenue by Class</h6>
                                            </div>
                                            <div class="card-body">
                                                <div id="revenueByClass">
                                                    <!-- Revenue breakdown will be loaded here -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Flight Seats Management Modal -->
<div class="modal fade" id="flightSeatsModal" tabindex="-1" aria-labelledby="flightSeatsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="flightSeatsModalLabel">Manage Flight Seats</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-8">
                        <h6>Current Flight Seats</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Seat</th>
                                        <th>Class</th>
                                        <th>Status</th>
                                        <th>Customer</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="modalSeatsTableBody">
                                    <!-- Modal seats will be loaded here -->
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="mt-3">
                            <button type="button" class="btn btn-warning" onclick="regenerateAllSeats()">
                                <i class="fas fa-sync-alt"></i> Regenerate All Seats
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">Add Individual Seat</h6>
                            </div>
                            <div class="card-body">
                                <form id="addFlightSeatForm">
                                    <div class="mb-3">
                                        <label class="form-label">Available Seats</label>
                                        <select class="form-select" id="availableSeatSelect" required>
                                            <option value="">Select a seat...</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="seatOccupied">
                                            <label class="form-check-label" for="seatOccupied">
                                                Mark as occupied
                                            </label>
                                        </div>
                                    </div>
                                    <div class="mb-3" id="ticketIdGroup" style="display: none;">
                                        <label class="form-label">Ticket ID</label>
                                        <input type="number" class="form-control" id="ticketIdInput" placeholder="Enter ticket ID">
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-plus"></i> Add Seat
                                    </button>
                                </form>
                                
                                <div class="mt-3" id="availableSeatsInfo">
                                    <!-- Available seats info will be shown here -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Flight Services Management Modal -->
<div class="modal fade" id="flightServicesModal" tabindex="-1" aria-labelledby="flightServicesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="flightServicesModalLabel">Manage Flight Services</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Current Services</h6>
                        <div id="currentServicesContainer">
                            <!-- Current services will be loaded here -->
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">Add Service</h6>
                            </div>
                            <div class="card-body">
                                <form id="addServiceForm">
                                    <div class="mb-3">
                                        <label class="form-label">Available Services</label>
                                        <select class="form-select" id="availableServiceSelect" required>
                                            <option value="">Select a service...</option>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-plus"></i> Add Service
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Error Alert -->
<div id="errorAlert" class="alert alert-danger alert-dismissible fade" role="alert" style="display: none;">
    <i class="fas fa-exclamation-circle"></i>
    <span id="errorMessage"></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>

@section Scripts {
    <script src="~/js/flight-details.js"></script>
}
