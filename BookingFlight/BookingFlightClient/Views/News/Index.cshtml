@model BookingFlightClient.Models.DTO.NewsIndexDto
@{
    ViewData["Title"] = "Tin tức";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/common/Header.css">
    <link rel="stylesheet" href="~/css/common/Footer.css">
    <link rel="stylesheet" href="~/css/news/news-index.css">
}

<partial name="~/Views/Common/_Header.cshtml" />
    <div class="news-container">
        <div class="news-header">
            <h1 class="news-title">
                <span data-vn="Tin tức" data-en="News" data-zh="新闻">Tin tức</span>
            </h1>
            <p class="news-subtitle">
                <span data-vn="Cập nhật những thông tin mới nhất về hàng không và du lịch" 
                      data-en="Latest updates on aviation and travel" 
                      data-zh="航空旅游最新资讯">
                    Cập nhật những thông tin mới nhất về hàng không và du lịch
                </span>
            </p>
            <div class="news-stats">
                <div class="stat-item">
                    <i class="fas fa-newspaper"></i>
                    <span>@Model.TotalNews bài viết</span>
                </div>
                <div class="stat-item">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Cập nhật hàng ngày</span>
                </div>
                <div class="stat-item">
                    <i class="fas fa-eye"></i>
                    <span>Tin tức đáng tin cậy</span>
                </div>
            </div>
        </div>

        <div class="loading" id="loading">
            <div class="spinner"></div>
            <p>Đang tải tin tức...</p>
        </div>

        <div class="news-grid" id="newsGrid">
            @foreach (var news in Model.News)
            {
                <div class="news-card" onclick="location.href='/News/Details/@news.NewId'">
                    <img src="@news.ImageUrl" alt="@news.Title" class="news-image" loading="lazy">
                    <div class="news-content">
                        <span class="news-category">@news.Category</span>
                        <h3 class="news-card-title">@news.Title</h3>
                        <p class="news-summary">@news.Summary</p>
                        <div class="news-meta">
                            <div class="news-author">
                                <i class="fas fa-user"></i>
                                <span>@news.Author</span>
                            </div>
                            <div class="news-date">
                                @news.PublishedDate.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination-container">
                <div class="pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <a href="/News?page=@(Model.CurrentPage - 1)" class="pagination-btn">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    }
                    else
                    {
                        <span class="pagination-btn disabled">
                            <i class="fas fa-chevron-left"></i>
                        </span>
                    }

                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        @if (i == Model.CurrentPage)
                        {
                            <span class="pagination-btn active">@i</span>
                        }
                        else
                        {
                            <a href="/News?page=@i" class="pagination-btn">@i</a>
                        }
                    }

                    <div class="pagination-info">
                        Trang @Model.CurrentPage / @Model.TotalPages
                    </div>

                    @if (Model.HasNextPage)
                    {
                        <a href="/News?page=@(Model.CurrentPage + 1)" class="pagination-btn">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="pagination-btn disabled">
                            <i class="fas fa-chevron-right"></i>
                        </span>
                    }
                </div>
            </div>
        }
    </div>

<partial name="~/Views/Common/_Footer.cshtml" />

@section Scripts {
    <script src="~/js/news/news-index.js"></script>
}
