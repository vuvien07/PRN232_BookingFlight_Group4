@{
    ViewData["Title"] = "Item Details";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@section Styles {
    <link href="~/css/item-manage.css" rel="stylesheet" />
}

<div class="items-container">
    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading item details...</p>
    </div>

    <!-- Item Details Card -->
    <div id="itemDetailsCard" class="items-header fade-in" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>
                    <i class="fas fa-info-circle"></i>
                    <span id="headerItemName">Item Details</span>
                </h1>
                <p class="text-muted mb-0">View and manage item information</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-lg" onclick="openEditModal()">
                    <i class="fas fa-edit"></i> Edit Item
                </button>
                <a href="/ItemManage/Items" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-arrow-left"></i> Back to Items
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="item-image-section">
                    <div class="item-image-container-large">
                        <img id="itemImage" src="" alt="Item Image" class="item-image-large">
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="item-info-card">
                    <h3 id="itemName" class="item-title"></h3>
                    
                    <div class="item-meta-grid">
                        <div class="meta-item">
                            <span class="meta-label">Item ID:</span>
                            <span id="itemId" class="meta-value"></span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Status:</span>
                            <span id="itemStatus" class="meta-value"></span>
                        </div>
                    </div>

                    <div class="meta-item">
                        <span class="meta-label">Price:</span>
                        <span id="itemPrice" class="meta-value price-value"></span>
                    </div>

                    <div class="meta-item full-width">
                        <span class="meta-label">Description:</span>
                        <p id="itemDetail" class="meta-description"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Error Message -->
<div id="errorMessage" class="alert-custom alert-error fade-in" style="display: none;">
    <i class="fas fa-exclamation-triangle"></i>
    <span id="errorText"></span>
</div>

<!-- Edit Item Modal -->
<div class="modal fade" id="editItemModal" tabindex="-1" aria-labelledby="editItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editItemModalLabel">Edit Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editItemForm">
                    <input type="hidden" id="editItemId" value="">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editItemName" class="form-label">Item Name *</label>
                                <input type="text" class="form-control" id="editItemName" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editPrice" class="form-label">Price (VND) *</label>
                                <input type="number" class="form-control" id="editPrice" min="0" step="1000" required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="editDetail" class="form-label">Detail</label>
                        <textarea class="form-control" id="editDetail" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label">Image</label>
                                
                                <!-- Image Option Toggle -->
                                <div class="image-option-toggle">
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="editImageOption" id="editImageUrl" value="url" checked>
                                        <label class="btn btn-outline-primary" for="editImageUrl">
                                            <i class="fas fa-link"></i> Enter URL
                                        </label>
                                        
                                        <input type="radio" class="btn-check" name="editImageOption" id="editImageUpload" value="upload">
                                        <label class="btn btn-outline-primary" for="editImageUpload">
                                            <i class="fas fa-upload"></i> Upload File
                                        </label>
                                    </div>
                                </div>
                                
                                <!-- URL Input Container -->
                                <div id="editUrlInputContainer" class="upload-section">
                                    <input type="text" class="form-control" id="editImage" placeholder="https://example.com/image.jpg">
                                    <div class="upload-info">
                                        <i class="fas fa-info-circle"></i> Enter a valid image URL (JPEG, PNG, GIF)
                                    </div>
                                </div>
                                
                                <!-- File Upload Container -->
                                <div id="editFileUploadContainer" class="file-upload-container" style="display: none;">
                                    <div class="file-upload-area">
                                        <label for="editImageFile" class="file-upload-btn" id="editFileUploadBtn">
                                            <i class="fas fa-cloud-upload-alt"></i>
                                            <div>Click to select image or drag & drop</div>
                                            <div class="upload-info">JPEG, PNG, GIF files up to 5MB</div>
                                        </label>
                                        <input type="file" id="editImageFile" accept="image/jpeg,image/jpg,image/png,image/gif">
                                    </div>
                                    
                                    <div class="upload-actions" style="display: none;" id="editUploadActions">
                                        <button type="button" class="btn btn-success btn-sm" id="editUploadBtn">
                                            <i class="fas fa-upload"></i> Upload Image
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" id="editCancelUploadBtn">
                                            <i class="fas fa-times"></i> Cancel
                                        </button>
                                    </div>
                                    
                                    <div class="upload-progress" style="display: none;" id="editUploadProgress">
                                        <div class="progress">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="editStatusId" class="form-label">Status</label>
                                <select class="form-control" id="editStatusId">
                                    <option value="1">Active</option>
                                    <option value="2">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Image Preview -->
                    <div class="mb-3" id="editImagePreviewContainer" style="display: none;">
                        <label class="form-label">Image Preview</label>
                        <div>
                            <img id="editImagePreview" src="" alt="Image Preview" class="img-thumbnail" style="max-width: 200px; max-height: 200px;">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveItemChanges()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const itemId = @ViewBag.ItemId;
    </script>
    <script src="~/js/item-details.js"></script>
}
