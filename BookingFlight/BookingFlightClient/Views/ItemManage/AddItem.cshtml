@{
    ViewData["Title"] = "Add New Item";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@section Styles {
    <link href="~/css/item-manage.css" rel="stylesheet" />
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4><i class="fas fa-plus"></i> Add New Item</h4>
            <a href="/ItemManage/Items" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Back to Items
            </a>
        </div>

        <form id="addItemForm">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="itemName" class="form-label">Item Name *</label>
                        <input type="text" class="form-control" id="itemName" required>
                        <div class="invalid-feedback">Please provide a valid item name.</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="price" class="form-label">Price (VND) *</label>
                        <input type="number" class="form-control" id="price" min="0" step="1000" required>
                        <div class="invalid-feedback">Please provide a valid price.</div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label for="detail" class="form-label">Detail</label>
                <textarea class="form-control" id="detail" rows="4" placeholder="Enter item description..."></textarea>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label">Image</label>
                        
                        <!-- Image Option Toggle -->
                        <div class="image-option-toggle">
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="imageOption" id="imageUrl" value="url" checked>
                                <label class="btn btn-outline-primary" for="imageUrl">
                                    <i class="fas fa-link"></i> Enter URL
                                </label>
                                
                                <input type="radio" class="btn-check" name="imageOption" id="imageUpload" value="upload">
                                <label class="btn btn-outline-primary" for="imageUpload">
                                    <i class="fas fa-upload"></i> Upload File
                                </label>
                            </div>
                        </div>
                        
                        <!-- URL Input Container -->
                        <div id="urlInputContainer" class="upload-section">
                            <input type="text" class="form-control" id="image" placeholder="https://example.com/image.jpg">
                            <div class="upload-info">
                                <i class="fas fa-info-circle"></i> Enter a valid image URL (JPEG, PNG, GIF)
                            </div>
                        </div>
                        
                        <!-- Hidden input to store image value for upload mode -->
                        <input type="hidden" id="imageValue" value="">
                        
                        <!-- File Upload Container -->
                        <div id="fileUploadContainer" class="file-upload-container" style="display: none;">
                            <div class="file-upload-area">
                                <label for="imageFile" class="file-upload-btn">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <div>Click to select image or drag & drop</div>
                                    <div class="upload-info">JPEG, PNG, GIF files up to 5MB</div>
                                </label>
                                <input type="file" id="imageFile" accept="image/jpeg,image/jpg,image/png,image/gif">
                            </div>
                            
                            <div class="upload-actions" style="display: none;" id="uploadActions">
                                <button type="button" class="btn btn-success btn-sm" id="uploadBtn">
                                    <i class="fas fa-upload"></i> Upload Image
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm ms-2" id="cancelUploadBtn">
                                    <i class="fas fa-times"></i> Cancel
                                </button>
                            </div>
                            
                            <div class="upload-progress" style="display: none;" id="uploadProgress">
                                <div class="progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="statusId" class="form-label">Status</label>
                        <select class="form-control" id="statusId">
                            <option value="1" selected>Active</option>
                            <option value="2">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Image Preview -->
            <div class="mb-3" id="imagePreviewContainer" style="display: none;">
                <label class="form-label">Image Preview</label>
                <div>
                    <img id="imagePreview" src="" alt="Image Preview" class="img-thumbnail" style="max-width: 200px; max-height: 200px;">
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-secondary me-2" onclick="resetForm()">
                    <i class="fas fa-undo"></i> Reset
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Item
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="alertContainer"></div>

@section Scripts {
    <script src="~/js/item-add.js"></script>
}
