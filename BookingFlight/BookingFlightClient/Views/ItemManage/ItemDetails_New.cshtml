@{
    ViewData["Title"] = "Item Details";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@section Styles {
    <link href="~/css/item-manage.css" rel="stylesheet" />
}

<!-- Loading Spinner -->
<div id="loadingSpinner" class="text-center">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Item Details Card -->
<div id="itemDetailsCard" class="card" style="display: none;">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4><i class="fas fa-info-circle"></i> Item Details</h4>
            <div>
                <button class="btn btn-primary me-2" onclick="openEditModal()">
                    <i class="fas fa-edit"></i> Edit Item
                </button>
                <a href="/ItemManage/Items" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Items
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="text-center">
                    <img id="itemImage" src="" alt="Item Image" class="img-fluid rounded shadow-sm" style="max-height: 300px;">
                </div>
            </div>
            <div class="col-md-8">
                <div class="item-info">
                    <h3 id="itemName" class="mb-3"></h3>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Item ID:</strong>
                            <span id="itemId"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>Status:</strong>
                            <span id="itemStatus" class="badge"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Price:</strong>
                        <span id="itemPrice" class="text-primary h5"></span>
                    </div>

                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p id="itemDetail" class="text-muted"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Error Message -->
<div id="errorMessage" class="alert alert-danger" style="display: none;">
    <i class="fas fa-exclamation-triangle"></i>
    <span id="errorText"></span>
</div>

<!-- Edit Item Modal -->
<div class="modal fade" id="editItemModal" tabindex="-1" aria-labelledby="editItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editItemModalLabel">Edit Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editItemForm">
                    <input type="hidden" id="editItemId" value="">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editItemName" class="form-label">Item Name *</label>
                                <input type="text" class="form-control" id="editItemName" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editPrice" class="form-label">Price (VND) *</label>
                                <input type="number" class="form-control" id="editPrice" min="0" step="1000" required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="editDetail" class="form-label">Detail</label>
                        <textarea class="form-control" id="editDetail" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editImage" class="form-label">Image URL</label>
                                <input type="text" class="form-control" id="editImage" placeholder="Enter image URL">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editStatusId" class="form-label">Status</label>
                                <select class="form-control" id="editStatusId">
                                    <option value="1">Active</option>
                                    <option value="2">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Image Preview -->
                    <div class="mb-3" id="editImagePreviewContainer" style="display: none;">
                        <label class="form-label">Image Preview</label>
                        <div>
                            <img id="editImagePreview" src="" alt="Image Preview" class="img-thumbnail" style="max-width: 200px; max-height: 200px;">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveItemChanges()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const itemId = @ViewBag.ItemId;
    </script>
    <script src="~/js/item-details.js"></script>
}
