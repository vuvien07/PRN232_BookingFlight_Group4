@model List<BookingFlightClient.Controllers.ComplaintResponseDto>
@{
    ViewData["Title"] = "Quản lý khiếu nại - Supporter";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        <i class="fas fa-headset me-2"></i>
                        Quản lý khiếu nại - Supporter
                    </h4>
                    <p class="card-description">Xử lý và giải quyết các khiếu nại được phân công</p>
                </div>
                <div class="card-body">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h3 id="totalComplaints">@Model.Count</h3>
                                    <p>Tổng khiếu nại</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body text-center">
                                    <h3 id="pendingComplaints">@Model.Count(c => c.StatusId == 3)</h3>
                                    <p>Đang xử lý</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h3 id="resolvedComplaints">@Model.Count(c => c.StatusId == 4)</h3>
                                    <p>Đã giải quyết</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h3 id="todayComplaints">@Model.Count(c => c.CreateAt?.Date == DateTime.Today)</h3>
                                    <p>Hôm nay</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="complaintsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Khách hàng</th>
                                    <th>Email</th>
                                    <th>Mô tả</th>
                                    <th>Ngày tạo</th>
                                    <th>Trạng thái</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var complaint in Model)
                                {
                                    <tr data-complaint-id="@complaint.ComplaintId">
                                        <td>@complaint.ComplaintId</td>
                                        <td>@complaint.CustomerName</td>
                                        <td>@complaint.CustomerEmail</td>
                                        <td>
                                            <div class="description-cell" title="@(complaint.Description ?? "")">
                                                @if (!string.IsNullOrEmpty(complaint.Description) && complaint.Description.Length > 50)
                                                {
                                                    @(complaint.Description.Substring(0, 50) + "...")
                                                }
                                                else
                                                {
                                                    @(complaint.Description ?? "Không có mô tả")
                                                }
                                            </div>
                                        </td>
                                        <td>@complaint.CreateAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <span class="badge bg-@(complaint.StatusId == 3 ? "warning" : complaint.StatusId == 4 ? "success" : "secondary")">
                                                @complaint.StatusName
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-info view-details-btn"
                                                        data-complaint-id="@complaint.ComplaintId"
                                                        title="Xem chi tiết">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                @if (complaint.StatusId == 3)
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-success resolve-btn"
                                                            data-complaint-id="@complaint.ComplaintId"
                                                            data-customer-name="@complaint.CustomerName"
                                                            data-customer-email="@complaint.CustomerEmail"
                                                            data-description="@(complaint.Description ?? "")"
                                                            title="Giải quyết">
                                                        <i class="fas fa-check"></i> Giải quyết
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Complaint Resolution -->
<div class="modal fade" id="resolveModal" tabindex="-1" aria-labelledby="resolveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="resolveModalLabel">
                    <i class="fas fa-envelope me-2"></i>
                    Gửi email giải quyết khiếu nại
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="resolveForm">
                    <input type="hidden" id="modalComplaintId" />
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="modalCustomerName" class="form-label">Tên khách hàng</label>
                                <input type="text" class="form-control" id="modalCustomerName" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="modalCustomerEmail" class="form-label">Email khách hàng</label>
                                <input type="email" class="form-control" id="modalCustomerEmail" readonly>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="modalComplaintDescription" class="form-label">Nội dung khiếu nại</label>
                        <textarea class="form-control" id="modalComplaintDescription" rows="3" readonly></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label for="emailSubject" class="form-label">Tiêu đề email</label>
                        <input type="text" class="form-control" id="emailSubject" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="emailContent" class="form-label">Nội dung email</label>
                        <div class="d-flex mb-2">
                            <button type="button" class="btn btn-outline-primary btn-sm me-2" id="generateAISuggestion">
                                <i class="fas fa-robot me-1"></i>
                                Tạo gợi ý AI
                            </button>
                            <div class="spinner-border spinner-border-sm d-none" id="aiLoadingSpinner" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <textarea class="form-control" id="emailContent" rows="8" required
                                   placeholder="Nhập nội dung email phản hồi cho khách hàng..."></textarea>
                    </div>
                    
                    <div id="aiSuggestionBox" class="alert alert-info d-none">
                        <h6><i class="fas fa-lightbulb me-2"></i>Gợi ý từ AI:</h6>
                        <div id="aiSuggestionContent"></div>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="useAISuggestion">
                            Sử dụng gợi ý này
                        </button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="sendEmailBtn">
                    <i class="fas fa-paper-plane me-1"></i>
                    Gửi email & Đánh dấu đã giải quyết
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Complaint Details -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i>
                    Chi tiết khiếu nại
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsModalBody">
                <!-- Details will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<style>
    .description-cell {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: pointer;
    }
    
    .card {
        border: none;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        border-radius: 10px;
    }
    
    .table th {
        border-top: none;
        font-weight: 600;
    }
    
    .btn-group .btn {
        margin-right: 5px;
    }
    
    #aiSuggestionBox {
        border-left: 4px solid #007bff;
        background-color: #f8f9fa;
    }
    
    .spinner-border-sm {
        width: 1rem;
        height: 1rem;
    }
</style>

<script>
    let currentComplaintId = 0;
    let currentComplaintDescription = '';
    
    document.addEventListener('DOMContentLoaded', function() {
        // Event listeners for view details buttons
        document.querySelectorAll('.view-details-btn').forEach(button => {
            button.addEventListener('click', function() {
                const complaintId = this.getAttribute('data-complaint-id');
                console.log('View details clicked for complaint:', complaintId);
                viewComplaintDetails(complaintId);
            });
        });
        
        // Event listeners for resolve buttons
        document.querySelectorAll('.resolve-btn').forEach(button => {
            button.addEventListener('click', function() {
                const complaintId = this.getAttribute('data-complaint-id');
                const customerName = this.getAttribute('data-customer-name');
                const customerEmail = this.getAttribute('data-customer-email');
                const description = this.getAttribute('data-description');
                const title = `Khiếu nại #${complaintId}`;
                
                console.log('Resolve clicked for complaint:', { complaintId, customerName, customerEmail, description, title });
                openResolveModal(complaintId, customerName, customerEmail, title, description);
            });
        });
        
        // AI suggestion button
        document.getElementById('generateAISuggestion').addEventListener('click', function() {
            const spinner = document.getElementById('aiLoadingSpinner');
            const button = this;
            
            if (!currentComplaintDescription) {
                showNotification('Lỗi', 'Không có mô tả khiếu nại để tạo gợi ý', 'error');
                return;
            }
            
            // Show loading
            spinner.classList.remove('d-none');
            button.disabled = true;
            
            fetch('/SupporterComplaint/GenerateAIResponse', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({
                    complaintDescription: currentComplaintDescription
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('aiSuggestionContent').textContent = data.suggestion;
                    document.getElementById('aiSuggestionBox').classList.remove('d-none');
                } else {
                    showNotification('Lỗi', data.message || 'Không thể tạo gợi ý AI', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Lỗi', 'Có lỗi xảy ra khi tạo gợi ý AI', 'error');
            })
            .finally(() => {
                spinner.classList.add('d-none');
                button.disabled = false;
            });
        });
        
        // Use AI suggestion button
        document.getElementById('useAISuggestion').addEventListener('click', function() {
            const suggestion = document.getElementById('aiSuggestionContent').textContent;
            document.getElementById('emailContent').value = suggestion;
            document.getElementById('aiSuggestionBox').classList.add('d-none');
        });
        
        // Send email button
        document.getElementById('sendEmailBtn').addEventListener('click', function() {
            const complaintId = document.getElementById('modalComplaintId').value;
            const customerEmail = document.getElementById('modalCustomerEmail').value;
            const customerName = document.getElementById('modalCustomerName').value;
            const subject = document.getElementById('emailSubject').value;
            const content = document.getElementById('emailContent').value;
            
            if (!subject || !content) {
                showNotification('Lỗi', 'Vui lòng điền đầy đủ tiêu đề và nội dung email', 'error');
                return;
            }
            
            const button = this;
            button.disabled = true;
            
            fetch('/SupporterComplaint/SendResolutionEmail', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({
                    complaintId: parseInt(complaintId),
                    customerEmail: customerEmail,
                    customerName: customerName,
                    subject: subject,
                    content: content
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('Thành công', data.message, 'success');
                    
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('resolveModal'));
                    modal.hide();
                    
                    // Refresh page to show updated status
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    showNotification('Lỗi', data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Lỗi', 'Có lỗi xảy ra khi gửi email', 'error');
            })
            .finally(() => {
                button.disabled = false;
            });
        });
        
        // Initialize DataTable
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            $('#complaintsTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json"
                },
                "pageLength": 10,
                "order": [[0, "desc"]]
            });
        }
    });
    
    function openResolveModal(complaintId, customerName, customerEmail, title, description) {
        console.log('openResolveModal called with:', { complaintId, customerName, customerEmail, title, description });
        
        currentComplaintId = complaintId;
        currentComplaintDescription = description;
        
        document.getElementById('modalComplaintId').value = complaintId;
        document.getElementById('modalCustomerName').value = customerName;
        document.getElementById('modalCustomerEmail').value = customerEmail;
        document.getElementById('modalComplaintDescription').value = description;
        document.getElementById('emailSubject').value = `Phản hồi khiếu nại: ${title}`;
        document.getElementById('emailContent').value = '';
        
        // Hide AI suggestion box
        document.getElementById('aiSuggestionBox').classList.add('d-none');
        
        const modal = new bootstrap.Modal(document.getElementById('resolveModal'));
        modal.show();
    }
    
    function viewComplaintDetails(complaintId) {
        console.log('viewComplaintDetails called with:', complaintId);
        
        fetch(`/SupporterComplaint/GetComplaintDetails?id=${complaintId}`)
            .then(response => {
                console.log('Response status:', response.status);
                return response.json();
            })
            .then(data => {
                console.log('Response data:', data);
                if (data.success) {
                    const complaint = data.complaint;
                    const detailsHtml = `
                        <div class="row">
                            <div class="col-md-6">
                                <strong>ID:</strong> ${complaint.id}<br>
                                <strong>Khách hàng:</strong> ${complaint.customerName}<br>
                                <strong>Email:</strong> ${complaint.customerEmail}<br>
                                <strong>Trạng thái:</strong> <span class="badge bg-info">${complaint.statusName}</span>
                            </div>
                            <div class="col-md-6">
                                <strong>Ngày tạo:</strong> ${complaint.createdDate}
                            </div>
                        </div>
                        <hr>
                        <div class="mb-3">
                            <strong>Tiêu đề:</strong><br>
                            Khiếu nại #${complaint.id}
                        </div>
                        <div class="mb-3">
                            <strong>Mô tả chi tiết:</strong><br>
                            <div class="p-3 bg-light rounded">
                                ${complaint.description || 'Không có mô tả'}
                            </div>
                        </div>
                    `;
                    
                    document.getElementById('detailsModalBody').innerHTML = detailsHtml;
                    const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
                    modal.show();
                } else {
                    showNotification('Lỗi', data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Lỗi', 'Có lỗi xảy ra khi tải chi tiết khiếu nại', 'error');
            });
    }
    
    function showNotification(title, message, type) {
        // Create notification element
        const notification = document.createElement('div');
        notification.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show position-fixed`;
        notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        notification.innerHTML = `
            <strong>${title}:</strong> ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        document.body.appendChild(notification);
        
        // Auto remove after 5 seconds
        setTimeout(() => {
            if (notification.parentNode) {
                notification.parentNode.removeChild(notification);
            }
        }, 5000);
    }
</script>
