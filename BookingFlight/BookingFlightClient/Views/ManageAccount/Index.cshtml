@using BookingFlightClient.Models.DTO
@model List<ResponseAccountDTO>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<style>
    body {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        min-height: 100vh;
    }

    .table-wrapper {
        background: #ffffff;
        border-radius: 1rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        padding: 1rem;
    }

    .table thead th {
        background-color: #f1f3f5;
        font-weight: 600;
    }

    .btn-custom {
        border-radius: 8px;
    }

    .btn-add {
        background: linear-gradient(45deg, #28a745, #218838);
        color: #fff;
    }

        .btn-add:hover {
            background: linear-gradient(45deg, #218838, #1e7e34);
            color: #fff;
        }

    .badge-role {
        font-size: 0.9rem;
        padding: 0.4em 0.7em;
        border-radius: 50px;
    }

    .badge-status {
        font-size: 0.85rem;
        border-radius: 50px;
    }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-people-fill"></i> Quản lý tài khoản
        </h2>
        <a asp-action="Add" asp-controller="ManageAccount" class="btn btn-add btn-custom">
            <i class="bi bi-plus-circle me-1"></i> Thêm tài khoản
        </a>
    </div>

    <div class="table-wrapper">
        <table class="table table-hover align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Account ID</th>
                    <th>Tên đăng nhập</th>
                    <th>Quyền</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@item.AccountId</td>
                            <td class="fw-semibold">@item.Username</td>
                            <td>
                                <span class="badge bg-info badge-role">
                                    <i class="bi bi-shield-lock"></i> @item.Role
                                </span>
                            </td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success badge-status">
                                        <i class="bi bi-check-circle"></i> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger badge-status">
                                        <i class="bi bi-x-circle"></i> Tạm khóa
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    // action="/ManageAccount/BanAccount"
                                    <form method="post" asp-action="BanAccount" asp-controller="ManageAccount"  style="display:inline;">
                                        <input type="hidden" name="accountId" value="@item.AccountId" />
                                        <button type="submit" class="btn btn-sm btn-warning btn-custom" onclick="return confirm('Bạn có chắc muốn khóa tài khoản này?')">
                                            <i class="bi bi-lock-fill"></i> Khóa
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="UnBanAccount" asp-controller="ManageAccount" style="display:inline;">
                                        <input type="hidden" name="accountId" value="@item.AccountId" />
                                        <button type="submit" class="btn btn-sm btn-success btn-custom" onclick="return confirm('Bạn có chắc muốn mở khóa tài khoản này?')">
                                            <i class="bi bi-unlock-fill"></i> Mở khóa
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-exclamation-circle fs-3"></i><br />
                            Không có tài khoản nào được tìm thấy.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
