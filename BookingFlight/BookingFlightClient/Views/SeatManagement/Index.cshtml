@model List<BookingFlightClient.Controllers.SeatListItemDTO>

@{
    ViewData["Title"] = "Seat Management";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-chair me-3 text-primary"></i>Seat Management
            </h2>
            <p class="text-muted mb-0">Quản lý ghế ngồi cho các máy bay</p>
        </div>
        <div class="btn-group">
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add Single Seat
            </a>
            <a href="@Url.Action("BulkCreate")" class="btn btn-success">
                <i class="fas fa-layer-group me-2"></i>Bulk Create Seats
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Count</h4>
                            <p class="mb-0">Total Seats</p>
                        </div>
                        <i class="fas fa-chair fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Count(s => s.StatusName == "Available")</h4>
                            <p class="mb-0">Available</p>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Count(s => s.StatusName == "Booked")</h4>
                            <p class="mb-0">Booked</p>
                        </div>
                        <i class="fas fa-bookmark fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Count(s => s.StatusName == "Maintenance")</h4>
                            <p class="mb-0">Maintenance</p>
                        </div>
                        <i class="fas fa-tools fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Search by Seat Number</label>
                    <input type="text" class="form-control" name="search" placeholder="Enter seat number...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Filter by Plane</label>
                    <select class="form-select" name="planeId">
                        <option value="">All Planes</option>
                        @foreach (var plane in Model.GroupBy(s => s.PlaneName).Select(g => g.First()))
                        {
                            <option value="@plane.PlaneName">@plane.PlaneName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Filter by Class</label>
                    <select class="form-select" name="classId">
                        <option value="">All Classes</option>
                        @foreach (var seatClass in Model.GroupBy(s => s.ClassName).Select(g => g.First()))
                        {
                            <option value="@seatClass.ClassName">@seatClass.ClassName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Filter by Status</label>
                    <select class="form-select" name="statusId">
                        <option value="">All Statuses</option>
                        @foreach (var status in Model.GroupBy(s => s.StatusName).Select(g => g.First()))
                        {
                            <option value="@status.StatusName">@status.StatusName</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-2"></i>Filter
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-undo me-2"></i>Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Seats Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>Seat List
                <span class="badge bg-secondary ms-2">@Model.Count seats</span>
            </h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="seatsTable">
                        <thead class="table-dark">
                            <tr>
                                <th>
                                    <i class="fas fa-hashtag me-1"></i>Seat #
                                </th>
                                <th>
                                    <i class="fas fa-plane me-1"></i>Plane
                                </th>
                                <th>
                                    <i class="fas fa-star me-1"></i>Class
                                </th>
                                <th>
                                    <i class="fas fa-info-circle me-1"></i>Status
                                </th>
                                <th class="text-center">
                                    <i class="fas fa-cogs me-1"></i>Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var seat in Model)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-primary">@seat.SeatNumber</strong>
                                    </td>
                                    <td>
                                        <i class="fas fa-plane me-2 text-muted"></i>@seat.PlaneName
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@seat.ClassName</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(seat.StatusName == "Available" ? "success" : 
                                                                 seat.StatusName == "Booked" ? "warning" : 
                                                                 seat.StatusName == "Maintenance" ? "danger" : "secondary")">
                                            <i class="fas fa-@(seat.StatusName == "Available" ? "check" : 
                                                               seat.StatusName == "Booked" ? "bookmark" : 
                                                               seat.StatusName == "Maintenance" ? "tools" : "question") me-1"></i>
                                            @seat.StatusName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { id = seat.SeatId })" 
                                               class="btn btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = seat.SeatId })" 
                                               class="btn btn-outline-warning" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", new { id = seat.SeatId })" 
                                               class="btn btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-chair fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No seats found</h4>
                    <p class="text-muted mb-4">There are no seats in the system yet.</p>
                    <a href="@Url.Action("BulkCreate")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create Your First Seats
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#seatsTable').DataTable({
                "pageLength": 25,
                "order": [[0, "asc"]],
                "language": {
                    "search": "Search seats:",
                    "lengthMenu": "Show _MENU_ seats per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ seats",
                    "paginate": {
                        "first": "First",
                        "last": "Last",
                        "next": "Next",
                        "previous": "Previous"
                    }
                }
            });

            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Confirm delete action
            $('a[href*="Delete"]').click(function(e) {
                if (!confirm('Are you sure you want to delete this seat?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
