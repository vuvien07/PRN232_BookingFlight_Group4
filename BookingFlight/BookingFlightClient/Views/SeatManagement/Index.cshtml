@{
    ViewData["Title"] = "Seat Management";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-chair me-3 text-primary"></i>Seat Management
            </h2>
            <p class="text-muted mb-0">Quản lý ghế ngồi cho các máy bay</p>
        </div>
        <div class="btn-group">
            <a href="@Url.Action("FlightSeats")" class="btn btn-primary">
                <i class="fas fa-plane me-2"></i>Manage Flight Seats
            </a>
        </div>
    </div>
    
    <!-- Welcome Card -->
    <div class="card">
        <div class="card-body text-center">
            <i class="fas fa-chair fa-5x text-primary mb-3"></i>
            <h3>Welcome to Seat Management</h3>
            <p class="text-muted mb-4">Manage seats for flights efficiently and effectively</p>
            <a href="@Url.Action("FlightSeats")" class="btn btn-primary btn-lg">
                <i class="fas fa-plane me-2"></i>Start Managing Flight Seats
            </a>
        </div>
    </div>
</div>
